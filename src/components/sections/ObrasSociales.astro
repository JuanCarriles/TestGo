---
import type { ObraSocial } from '../../types';
import { urlFor } from '../../lib/sanity';

interface Props {
  obrasSociales: ObraSocial[];
}

const { obrasSociales } = Astro.props;
---

<section class="py-24 bg-background">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <span class="text-sm font-semibold uppercase tracking-wider text-primary">Cobertura</span>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-text sm:text-4xl">
        Obras Sociales Aceptadas
      </h2>
      <p class="mt-4 text-lg text-text/60 max-w-2xl mx-auto">
        Trabajamos con las principales obras sociales y prepagas del país.
      </p>
    </div>

    {obrasSociales.length > 0 ? (
      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 items-center">
        {obrasSociales.map((obra) => (
          <div class="group flex flex-col items-center justify-center p-6 rounded-xl bg-surface/5 border border-text/5 transition-all duration-300 hover:-translate-y-1 hover:shadow-md hover:border-surface/20">
            {obra.logo?.asset ? (
              <img
                src={urlFor(obra.logo.asset)}
                alt={obra.logo.alt || obra.nombre}
                class="h-16 w-auto object-contain grayscale opacity-60 transition-all duration-300 group-hover:grayscale-0 group-hover:opacity-100"
                loading="lazy"
              />
            ) : (
              <span class="text-sm font-medium text-text/40 text-center">{obra.nombre}</span>
            )}
          </div>
        ))}
      </div>
    ) : (
      <div class="text-center py-12">
        <p class="text-text/40">Próximamente actualizaremos la lista de obras sociales.</p>
      </div>
    )}
  </div>
</section>
