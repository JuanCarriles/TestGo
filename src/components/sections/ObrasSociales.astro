---
import type { HomePage } from '../../types';
import { urlFor } from '../../lib/sanity';

interface Props {
  homePage: HomePage | null;
}

const { homePage } = Astro.props;

// Demo logos when no data
const demoObras = [
  { nombre: 'OSDE' },
  { nombre: 'Swiss Medical' },
  { nombre: 'Galeno' },
  { nombre: 'Medifé' },
  { nombre: 'OMINT' },
  { nombre: 'Medicus' },
  { nombre: 'Sancor Salud' },
  { nombre: 'Luis Pasteur' },
];

const obras = homePage?.obrasSociales?.length
  ? homePage.obrasSociales
  : demoObras;
---

<section data-reveal="right" class="relative py-16 md:py-28 bg-background overflow-hidden">
  {/* Decorative gradient */}
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 h-[400px] w-[400px] md:h-[600px] md:w-[600px] bg-primary/5 rounded-full blur-3xl"></div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12 md:mb-20">
      <span class="inline-block text-sm font-semibold uppercase tracking-[0.2em] text-primary mb-3 md:mb-4 font-body">Cobertura</span>
      <h2 class="text-3xl md:text-5xl font-bold tracking-tight text-text sm:text-4xl lg:text-6xl font-display">
        Obras Sociales <span class="text-gradient">Aceptadas</span>
      </h2>
      <p class="mt-4 md:mt-6 text-base md:text-lg text-text/50 max-w-2xl mx-auto font-body font-light">
        Trabajamos con las principales obras sociales y prepagas del país para tu tranquilidad.
      </p>
    </div>

    <div class="grid grid-cols-2 gap-3 md:gap-6 sm:grid-cols-3 md:grid-cols-4">
      {obras.map((obra, index) => (
        <div class="group relative flex flex-col items-center justify-center rounded-3xl bg-surface/5 border border-text/5 p-8 transition-all duration-500 hover:-translate-y-2 hover:shadow-xl hover:border-primary/10 hover:bg-white">
          {obra.logo?.asset ? (
            <img
              src={urlFor(obra.logo.asset)}
              alt={obra.logo.alt || obra.nombre}
              class="h-16 w-auto object-contain grayscale opacity-60 transition-all duration-500 group-hover:grayscale-0 group-hover:opacity-100"
              loading="lazy"
            />
          ) : (
            <div class="flex flex-col items-center gap-3">
              <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-primary/10 text-primary transition-all duration-500 group-hover:bg-primary group-hover:text-white group-hover:shadow-glow">
                <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              </div>
              <span class="text-sm font-semibold text-text/40 group-hover:text-primary transition-colors duration-500 font-body">{obra.nombre}</span>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
