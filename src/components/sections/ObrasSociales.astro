---
import type { HomePage } from '../../types';
import ObrasSocialesCarousel from '../../components/react/ObrasSocialesCarousel';

interface Props {
  homePage: HomePage | null;
}

const { homePage } = Astro.props;

// Demo logos when no data
const demoObras = [
  { nombre: 'OSDE', orden: 0 },
  { nombre: 'Swiss Medical', orden: 1 },
  { nombre: 'Galeno', orden: 2 },
  { nombre: 'Medifé', orden: 3 },
  { nombre: 'OMINT', orden: 4 },
  { nombre: 'Medicus', orden: 5 },
  { nombre: 'Sancor Salud', orden: 6 },
  { nombre: 'Luis Pasteur', orden: 7 },
  { nombre: 'IOMA', orden: 8 },
  { nombre: 'PAMI', orden: 9 },
];

const obrasRaw = homePage?.obrasSociales?.length
  ? homePage.obrasSociales
  : demoObras;

// Sort by orden
const obras = [...obrasRaw].sort((a, b) => (a.orden ?? 999) - (b.orden ?? 999));

// Button config
const botonTexto = homePage?.obrasSocialesBotonTexto || 'Ver todas las obras sociales';
const botonEnlace = homePage?.obrasSocialesBotonEnlace || '/nosotros';

// Header config
const badge = homePage?.obrasSocialesBadge || 'Cobertura';
const titulo = homePage?.obrasSocialesTitulo || 'Obras Sociales Aceptadas';
const tituloDestacado = homePage?.obrasSocialesTituloDestacado || 'Aceptadas';
const descripcion = homePage?.obrasSocialesDescripcion || 'Trabajamos con las principales obras sociales y prepagas del país para tu tranquilidad.';

// Process title
const tituloIndex = titulo.indexOf(tituloDestacado);
let tituloBefore = '';
let tituloAfter = '';

if (tituloIndex !== -1) {
  tituloBefore = titulo.slice(0, tituloIndex);
  tituloAfter = titulo.slice(tituloIndex + tituloDestacado.length);
} else {
  tituloBefore = titulo;
}
---

<section data-reveal="right" class="relative py-16 md:py-28 bg-background overflow-hidden">
  {/* Decorative gradient */}
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 h-[400px] w-[400px] md:h-[600px] md:w-[600px] bg-primary/5 rounded-full blur-3xl"></div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12 md:mb-20">
      <span class="inline-block text-sm font-semibold uppercase tracking-[0.2em] text-primary-dark mb-3 md:mb-4 font-body">{badge}</span>
      <h2 class="text-3xl md:text-5xl font-bold tracking-tight text-text sm:text-4xl lg:text-6xl font-display">
        {tituloBefore && <span>{tituloBefore}</span>}
        {tituloIndex !== -1 && <span class="text-gradient">{tituloDestacado}</span>}
        {tituloAfter && <span>{tituloAfter}</span>}
      </h2>
      <p class="mt-4 md:mt-6 text-base md:text-lg text-text/70 max-w-2xl mx-auto font-body font-light">
        {descripcion}
      </p>
    </div>

    <ObrasSocialesCarousel obras={obras} client:visible />

    {botonEnlace && botonTexto && (
      <div class="flex justify-center mt-10 md:mt-14">
        <a
          href={botonEnlace}
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center justify-center rounded-full bg-primary px-8 py-4 text-lg font-semibold text-white shadow-lg transition-all duration-500 hover:bg-primary/90 hover:shadow-glow hover:-translate-y-1 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:ring-offset-background font-body"
        >
          <span>{botonTexto}</span>
          <svg class="ml-2 h-5 w-5 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    )}
  </div>
</section>

<style is:global>
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
