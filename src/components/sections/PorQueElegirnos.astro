---
import type { HomePage } from '../../types';
import { getIconoSvg } from './iconos';
import { getImageUrl } from '../../lib/images';

interface Props {
  homePage: HomePage | null;
}

const { homePage } = Astro.props;

const pqe = homePage?.porQueElegirnos;

// Fallbacks
const slides = pqe?.imagenes?.length
  ? pqe.imagenes
  : [{ asset: { url: 'https://images.unsplash.com/photo-1631217868264-e5b90bb7e133?auto=format&fit=crop&q=80&w=800' }, alt: 'Instalaciones médicas' }];

const badge = pqe?.badge || 'Ventajas';
const titulo = pqe?.titulo || '¿Por qué elegirnos?';
const tituloDestacado = pqe?.tituloDestacado || 'elegirnos';
const descripcion = pqe?.descripcion || 'Nos diferenciamos por nuestra dedicación, tecnología y compromiso con la salud de cada paciente.';

const features = pqe?.features?.length
  ? pqe.features
  : [
      { icono: 'clock', titulo: 'Atención 24/7', descripcion: 'Estamos disponibles las 24 horas, los 7 días de la semana para urgencias y emergencias médicas.' },
      { icono: 'monitor', titulo: 'Tecnología de Vanguardia', descripcion: 'Equipamiento médico de última generación para diagnósticos precisos y tratamientos efectivos.' },
      { icono: 'user', titulo: 'Profesionales Expertos', descripcion: 'Equipo médico altamente calificado con amplia trayectoria en sus respectivas especialidades.' },
      { icono: 'calendar', titulo: 'Turnos Online', descripcion: 'Reservá tu consulta de manera rápida y sencilla desde cualquier dispositivo, en cualquier momento.' },
      { icono: 'building', titulo: 'Instalaciones Premium', descripcion: 'Ambientes diseñados para tu confort y bienestar, con estándares internacionales de calidad.' },
      { icono: 'shield', titulo: 'Obras Sociales', descripcion: 'Trabajamos con las principales obras sociales y prepagas para que accedas a la mejor cobertura.' },
    ];

const tarjetaNumero = pqe?.tarjetaFlotante?.numero || '+15 años';
const tarjetaEtiqueta = pqe?.tarjetaFlotante?.etiqueta || 'de trayectoria médica';

// Process title
const tituloIndex = titulo.indexOf(tituloDestacado);
let tituloBefore = '';
let tituloAfter = '';

if (tituloIndex !== -1) {
  tituloBefore = titulo.slice(0, tituloIndex);
  tituloAfter = titulo.slice(tituloIndex + tituloDestacado.length);
} else {
  tituloBefore = titulo;
}
---

<section data-reveal="left" class="relative py-16 md:py-28 bg-surface/5 overflow-hidden">
  {/* Background texture */}
  <div class="absolute inset-0 noise-overlay opacity-30"></div>
  
  {/* Decorative shapes - hidden on mobile */}
  <div class="hidden md:block absolute top-20 left-10 h-32 w-32 rounded-full border border-primary/10"></div>
  <div class="hidden md:block absolute bottom-20 right-20 h-48 w-48 rounded-full border border-secondary/10"></div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
      {/* Left - Image carousel */}
      <div class="relative">
        <div class="relative">
          {/* Main carousel */}
          <div class="relative rounded-2xl md:rounded-3xl overflow-hidden shadow-2xl" id="pqe-carousel">
            <div class="relative h-[300px] sm:h-[400px] lg:h-[500px] w-full">
              {slides.map((img, idx) => (
                <div
                  class="absolute inset-0 transition-opacity duration-1000 ease-in-out"
                  style={`opacity: ${idx === 0 ? 1 : 0}`}
                  data-slide={idx}
                >
                  <img
                    src={getImageUrl(img.asset?.url, { w: 800, h: 600, fit: 'crop' })}
                    alt={img.alt || 'Instalaciones médicas'}
                    class="h-full w-full object-cover"
                    loading={idx === 0 ? 'eager' : 'lazy'}
                  />
                </div>
              ))}
            </div>
            {/* Dots */}
            {slides.length > 1 && (
              <div class="absolute bottom-4 left-1/2 -translate-x-1/2 flex gap-2">
                {slides.map((_, idx) => (
                  <button
                    class={`h-2 rounded-full transition-all duration-300 ${idx === 0 ? 'w-6 bg-white' : 'w-2 bg-white/40 hover:bg-white/60'}`}
                    aria-label={`Ver imagen ${idx + 1}`}
                    data-dot={idx}
                  />
                ))}
              </div>
            )}
          </div>
          
          {/* Floating card */}
          <div class="absolute -bottom-4 -right-2 md:-bottom-8 md:-right-8 rounded-xl md:rounded-2xl bg-white shadow-xl border border-text/5 p-4 md:p-6 max-w-[200px] md:max-w-xs">
            <div class="flex items-center gap-3 md:gap-4">
              <div class="flex h-10 w-10 md:h-14 md:w-14 items-center justify-center rounded-full bg-primary/10 text-primary">
                <svg class="h-5 w-5 md:h-7 md:w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <p class="text-xl md:text-2xl font-bold text-text font-display">{tarjetaNumero}</p>
                <p class="text-xs md:text-sm text-text/50 font-body">{tarjetaEtiqueta}</p>
              </div>
            </div>
          </div>
          
          {/* Decorative element */}
          <div class="hidden md:block absolute -top-6 -left-6 h-24 w-24 rounded-2xl bg-secondary/10 -z-10"></div>
        </div>
      </div>

      {/* Right - Content */}
      <div>
        <span class="inline-block text-sm font-semibold uppercase tracking-[0.2em] text-primary mb-3 md:mb-4 font-body">{badge}</span>
        <h2 class="text-3xl md:text-5xl font-bold tracking-tight text-text sm:text-4xl lg:text-6xl font-display leading-tight">
          {tituloBefore && <span>{tituloBefore}</span>}
          {tituloIndex !== -1 && <span class="text-gradient">{tituloDestacado}</span>}
          {tituloAfter && <span>{tituloAfter}</span>}
        </h2>
        <p class="mt-4 md:mt-6 text-base md:text-lg text-text/50 font-body font-light leading-relaxed">
          {descripcion}
        </p>

        <div class="mt-8 md:mt-12 grid grid-cols-1 sm:grid-cols-2 gap-4 md:gap-6">
          {features.map((feature, index) => (
            <div class="group relative rounded-2xl bg-white p-5 md:p-6 shadow-sm border border-text/5 transition-all duration-500 hover:shadow-lg hover:-translate-y-1 hover:border-primary/10">
              <div class="mb-3 md:mb-4 inline-flex h-12 w-12 md:h-14 md:w-14 items-center justify-center rounded-xl bg-primary/5 text-primary transition-all duration-500 group-hover:bg-primary group-hover:text-white group-hover:shadow-glow">
                <svg class="h-6 w-6 md:h-7 md:w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" set:html={getIconoSvg(feature.icono)} />
              </div>
              <h3 class="text-base md:text-lg font-semibold text-text font-display">{feature.titulo}</h3>
              <p class="mt-1 md:mt-2 text-sm leading-relaxed text-text/50 font-body font-light">
                {feature.descripcion}
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
  <script is:inline>
    function initPqeCarousel() {
      var carousel = document.getElementById('pqe-carousel');
      if (!carousel) return;
      var slides = carousel.querySelectorAll('[data-slide]');
      var dots = carousel.querySelectorAll('[data-dot]');
      if (slides.length <= 1) return;

      var active = 0;
      var total = slides.length;

      function show(idx) {
        slides[active].style.opacity = '0';
        if (dots[active]) dots[active].className = 'h-2 rounded-full transition-all duration-300 w-2 bg-white/40 hover:bg-white/60';
        active = idx;
        slides[active].style.opacity = '1';
        if (dots[active]) dots[active].className = 'h-2 rounded-full transition-all duration-300 w-6 bg-white';
      }

      dots.forEach(function (dot, i) {
        dot.addEventListener('click', function () { show(i); });
      });

      // Clear existing interval to avoid duplicates
      if (window._pqeInterval) clearInterval(window._pqeInterval);
      window._pqeInterval = setInterval(function () {
        show((active + 1) % total);
      }, 5000);
    }

    document.addEventListener('astro:page-load', initPqeCarousel);
    if (document.readyState !== 'loading') initPqeCarousel();
  </script>
</section>
