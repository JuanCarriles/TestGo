---
const features = [
  {
    title: 'Atención 24/7',
    description: 'Estamos disponibles las 24 horas, los 7 días de la semana para urgencias y emergencias médicas.',
    icon: `<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
  },
  {
    title: 'Tecnología de Vanguardia',
    description: 'Equipamiento médico de última generación para diagnósticos precisos y tratamientos efectivos.',
    icon: `<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>`,
  },
  {
    title: 'Profesionales Expertos',
    description: 'Equipo médico altamente calificado con amplia trayectoria en sus respectivas especialidades.',
    icon: `<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>`,
  },
  {
    title: 'Turnos Online',
    description: 'Reservá tu consulta de manera rápida y sencilla desde cualquier dispositivo, en cualquier momento.',
    icon: `<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>`,
  },
  {
    title: 'Instalaciones Premium',
    description: 'Ambientes diseñados para tu confort y bienestar, con estándares internacionales de calidad.',
    icon: `<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>`,
  },
  {
    title: 'Obras Sociales',
    description: 'Trabajamos con las principales obras sociales y prepagas para que accedas a la mejor cobertura.',
    icon: `<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>`,
  },
];
---

<section class="py-24 bg-surface/5">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <span class="text-sm font-semibold uppercase tracking-wider text-primary">Ventajas</span>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-text sm:text-4xl">
        ¿Por qué elegirnos?
      </h2>
      <p class="mt-4 text-lg text-text/60 max-w-2xl mx-auto">
        Nos diferenciamos por nuestra dedicación, tecnología y compromiso con la salud de cada paciente.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {features.map((feature) => (
        <div class="group relative rounded-2xl bg-background p-8 shadow-sm border border-text/5 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:border-primary/10">
          <div class="mb-5 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-secondary/10 text-secondary">
            <Fragment set:html={feature.icon} />
          </div>
          <h3 class="text-lg font-semibold text-text">{feature.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-text/60">
            {feature.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
