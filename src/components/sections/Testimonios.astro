---
import type { HomePage } from '../../types';

interface Props {
  homePage: HomePage | null;
}

const { homePage } = Astro.props;

function renderStars(count: number): string {
  const fullStar = `<svg class="h-5 w-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>`;
  const emptyStar = `<svg class="h-5 w-5 text-gray-200" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>`;
  let html = '';
  for (let i = 0; i < 5; i++) {
    html += i < count ? fullStar : emptyStar;
  }
  return html;
}

// Demo testimonials when no data
const demoResenas = [
  { nombre: 'María González', texto: 'La atención en GO Centro Médico es excepcional. Desde que llegué me sentí cuidada y escuchada. Los médicos son verdaderos profesionales.', estrellas: 5, fecha: '2024-03-15' },
  { nombre: 'Carlos Rodríguez', texto: 'Excelente servicio y modernas instalaciones. Pude agendar mi turno online sin problemas y la consulta fue muy completa.', estrellas: 5, fecha: '2024-02-20' },
  { nombre: 'Laura Martínez', texto: 'Llevé a mis hijos a la pediatría y quedé encantada con el trato. Un equipo humano y profesional que transmite confianza.', estrellas: 5, fecha: '2024-01-10' },
];

const displayResenas = homePage?.testimonios?.length
  ? homePage.testimonios
  : demoResenas;
---

<section class="relative py-28 bg-text overflow-hidden">
  {/* Background image */}
  <div class="absolute inset-0">
    <img
      src="https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?auto=format&fit=crop&q=80&w=2000"
      alt="Fondo"
      class="h-full w-full object-cover opacity-10"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-text via-text/95 to-text"></div>
  </div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12 md:mb-20">
      <span class="inline-block text-sm font-semibold uppercase tracking-[0.2em] text-primary mb-4 font-body">Testimonios</span>
      <h2 class="text-3xl md:text-5xl font-bold tracking-tight text-white sm:text-4xl lg:text-6xl font-display">
        Lo que dicen <span class="text-gradient">nuestros pacientes</span>
      </h2>
      <p class="mt-4 md:mt-6 text-base md:text-lg text-white/50 max-w-2xl mx-auto font-body font-light">
        La confianza de nuestros pacientes es nuestro mayor orgullo.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
      {displayResenas.map((resena, index) => (
        <article class="group relative rounded-3xl bg-white/5 backdrop-blur-sm border border-white/10 p-8 transition-all duration-500 hover:bg-white/10 hover:border-white/20 hover:-translate-y-2 hover:shadow-2xl">
          {/* Quote icon */}
          <div class="absolute top-6 right-6 text-primary/20">
            <svg class="h-12 w-12" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
            </svg>
          </div>

          {/* Stars */}
          <div class="flex items-center gap-1 mb-6">
            <Fragment set:html={renderStars(resena.estrellas)} />
          </div>

          {/* Text */}
          <p class="text-base leading-relaxed text-white/70 mb-8 font-body font-light italic">
            "{resena.texto}"
          </p>

          {/* Author */}
          <div class="flex items-center gap-4 pt-6 border-t border-white/10">
            <div class="flex h-14 w-14 items-center justify-center rounded-full bg-gradient-to-br from-primary to-surface text-white font-semibold text-lg font-display">
              {resena.nombre.charAt(0).toUpperCase()}
            </div>
            <div>
              <p class="text-base font-semibold text-white font-body">{resena.nombre}</p>
              {resena.fecha && (
                <p class="text-xs text-white/40 font-body">{new Date(resena.fecha).toLocaleDateString('es-AR', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
