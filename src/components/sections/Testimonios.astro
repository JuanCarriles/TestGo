---
import type { Resena } from '../../types';

interface Props {
  resenas: Resena[];
}

const { resenas } = Astro.props;

function renderStars(count: number): string {
  const fullStar = `<svg class="h-5 w-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>`;
  const emptyStar = `<svg class="h-5 w-5 text-gray-300" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>`;
  let html = '';
  for (let i = 0; i < 5; i++) {
    html += i < count ? fullStar : emptyStar;
  }
  return html;
}
---

<section class="py-24 bg-surface/5">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <span class="text-sm font-semibold uppercase tracking-wider text-primary">Testimonios</span>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-text sm:text-4xl">
        Lo que dicen nuestros pacientes
      </h2>
      <p class="mt-4 text-lg text-text/60 max-w-2xl mx-auto">
        La confianza de nuestros pacientes es nuestro mayor orgullo.
      </p>
    </div>

    {resenas.length > 0 ? (
      <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
        {resenas.map((resena) => (
          <article class="relative rounded-2xl bg-background p-8 shadow-sm border border-text/5 transition-all duration-300 hover:shadow-lg">
            {/* Quote icon */}
            <div class="absolute top-6 right-6 text-primary/10">
              <svg class="h-10 w-10" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
              </svg>
            </div>

            {/* Stars */}
            <div class="flex items-center gap-1 mb-4">
              <Fragment set:html={renderStars(resena.estrellas)} />
            </div>

            {/* Text */}
            <p class="text-sm leading-relaxed text-text/70 mb-6">
              "{resena.texto}"
            </p>

            {/* Author */}
            <div class="flex items-center gap-3">
              <div class="flex h-10 w-10 items-center justify-center rounded-full bg-primary/10 text-primary font-semibold text-sm">
                {resena.nombre.charAt(0).toUpperCase()}
              </div>
              <div>
                <p class="text-sm font-semibold text-text">{resena.nombre}</p>
                {resena.fecha && (
                  <p class="text-xs text-text/40">{new Date(resena.fecha).toLocaleDateString('es-AR', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="text-center py-12">
        <p class="text-text/40">Próximamente compartiremos experiencias de nuestros pacientes.</p>
      </div>
    )}
  </div>
</section>
