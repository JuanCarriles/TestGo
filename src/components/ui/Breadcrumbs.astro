---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="w-full bg-text/5 border-b border-text/5">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-3">
    <ol class="flex flex-wrap items-center gap-2 text-sm text-text/50 font-body">
      <li>
        <a href="/" class="transition-colors duration-300 hover:text-primary focus:outline-none focus:text-primary">
          Inicio
        </a>
      </li>
      {items.map((item, index) => (
        <li class="flex items-center gap-2">
          <svg class="h-3.5 w-3.5 text-text/30 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
          {item.href && index < items.length - 1 ? (
            <a href={item.href} class="transition-colors duration-300 hover:text-primary focus:outline-none focus:text-primary">
              {item.label}
            </a>
          ) : (
            <span class="text-text/80 font-medium" aria-current="page">
              {item.label}
            </span>
          )}
        </li>
      ))}
    </ol>
  </div>
</nav>
