---
import Layout from '../../layouts/Layout.astro';
import { client } from '../../lib/sanity';
import { queries } from '../../lib/queries';
import type { Configuracion, Profesional } from '../../types';

export async function getStaticPaths() {
  const profesionales = await client.fetch<Profesional[]>(queries.todosProfesionales).catch(() => []);

  // Fallback to demo data if no profesionales from Sanity
  const paths = profesionales.length > 0
    ? profesionales.map((prof) => ({
        params: { slug: prof.slug },
      }))
    : [
        { params: { slug: 'ana-martinez' } },
        { params: { slug: 'carlos-rodriguez' } },
        { params: { slug: 'laura-fernandez' } },
        { params: { slug: 'martin-lopez' } },
        { params: { slug: 'sofia-gomez' } },
        { params: { slug: 'pablo-silva' } },
      ];

  return paths;
}

const { slug } = Astro.params;

const [config, profesional] = await Promise.all([
  client.fetch<Configuracion | null>(queries.configuracion).catch(() => null),
  client.fetch<Profesional | null>(queries.profesionalBySlug, { slug }).catch(() => null),
]);

// Demo fallback
const demoProfesionales: Record<string, Profesional> = {
  'ana-martinez': {
    _id: '1',
    nombre: 'Dra. Ana Martínez',
    slug: 'ana-martinez',
    foto: { asset: { _id: '', url: 'https://images.unsplash.com/photo-1559839734-2b71ea197ec2?auto=format&fit=crop&q=80&w=800' }, alt: 'Dra. Ana Martínez' },
    especialidad: { _id: '1', nombre: 'Cardiología', slug: 'cardiologia' },
    enlaceAgenda: '#',
    biografia: 'Especialista en cardiología intervencionista con más de 15 años de experiencia. Formada en la Universidad de Buenos Aires.',
  },
  'carlos-rodriguez': {
    _id: '2',
    nombre: 'Dr. Carlos Rodríguez',
    slug: 'carlos-rodriguez',
    foto: { asset: { _id: '', url: 'https://images.unsplash.com/photo-1612349317150-e413f6a5b16d?auto=format&fit=crop&q=80&w=800' }, alt: 'Dr. Carlos Rodríguez' },
    especialidad: { _id: '2', nombre: 'Traumatología', slug: 'traumatologia' },
    enlaceAgenda: '#',
    biografia: 'Cirujano ortopédico especializado en artroscopia y cirugía deportiva. Ex médico de selecciones nacionales.',
  },
  'laura-fernandez': {
    _id: '3',
    nombre: 'Dra. Laura Fernández',
    slug: 'laura-fernandez',
    foto: { asset: { _id: '', url: 'https://images.unsplash.com/photo-1594824476967-48c8b964273f?auto=format&fit=crop&q=80&w=800' }, alt: 'Dra. Laura Fernández' },
    especialidad: { _id: '3', nombre: 'Dermatología', slug: 'dermatologia' },
    enlaceAgenda: '#',
    biografia: 'Dermatóloga con enfoque en dermatología estética y tratamientos láser. Miembro de la Sociedad Argentina de Dermatología.',
  },
  'martin-lopez': {
    _id: '4',
    nombre: 'Dr. Martín López',
    slug: 'martin-lopez',
    foto: { asset: { _id: '', url: 'https://images.unsplash.com/photo-1622253692010-333f2da6031d?auto=format&fit=crop&q=80&w=800' }, alt: 'Dr. Martín López' },
    especialidad: { _id: '4', nombre: 'Pediatría', slug: 'pediatria' },
    enlaceAgenda: '#',
    biografia: 'Pediatra dedicado con especialización en neonatología. Conocido por su trato cálido y profesional con los más pequeños.',
  },
  'sofia-gomez': {
    _id: '5',
    nombre: 'Dra. Sofía Gómez',
    slug: 'sofia-gomez',
    foto: { asset: { _id: '', url: 'https://images.unsplash.com/photo-1651008376811-b90baee60c1f?auto=format&fit=crop&q=80&w=800' }, alt: 'Dra. Sofía Gómez' },
    especialidad: { _id: '5', nombre: 'Ginecología', slug: 'ginecologia' },
    enlaceAgenda: '#',
    biografia: 'Ginecóloga y obstetra con amplia experiencia en salud reproductiva y medicina fetal.',
  },
  'pablo-silva': {
    _id: '6',
    nombre: 'Dr. Pablo Silva',
    slug: 'pablo-silva',
    foto: { asset: { _id: '', url: 'https://images.unsplash.com/photo-1537368910025-700350fe46c7?auto=format&fit=crop&q=80&w=800' }, alt: 'Dr. Pablo Silva' },
    especialidad: { _id: '6', nombre: 'Neurología', slug: 'neurologia' },
    enlaceAgenda: '#',
    biografia: 'Neurólogo especializado en trastornos del movimiento y epilepsia. Investigador activo en neurociencias.',
  },
};

const prof = profesional || demoProfesionales[slug || ''] || null;

if (!prof) {
  return Astro.redirect('/equipo');
}

const fotoUrl = prof.foto?.asset?.url || '';
const fotoAlt = prof.foto?.alt || prof.nombre;
---

<Layout
  title={prof.nombre}
  description={`${prof.nombre} - ${prof.especialidad?.nombre || 'Especialista'} en GO Centro Médico. ${prof.biografia}`}
  config={config}
>
  {/* Hero */}
  <section class="relative bg-text py-16 md:py-24 lg:py-32 overflow-hidden">
    <div class="absolute inset-0">
      <img
        src="https://images.unsplash.com/photo-1579684385127-1ef15d508118?auto=format&fit=crop&q=80&w=2000"
        alt="Fondo"
        class="h-full w-full object-cover opacity-10"
      />
      <div class="absolute inset-0 bg-gradient-to-br from-text via-text to-primary/20"></div>
    </div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <a
        href="/equipo"
        class="inline-flex items-center gap-2 text-sm text-white/50 transition-colors duration-300 hover:text-primary font-body mb-6 md:mb-8"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Volver al equipo
      </a>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 md:gap-12 items-center">
        {/* Photo */}
        <div class="relative mx-auto lg:mx-0 max-w-[280px] md:max-w-sm">
          <div class="relative rounded-2xl md:rounded-3xl overflow-hidden shadow-2xl border border-white/10 aspect-[3/4]">
            {fotoUrl ? (
              <img
                src={fotoUrl}
                alt={fotoAlt}
                class="h-full w-full object-cover"
              />
            ) : (
              <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-surface/20 to-primary/5">
                <svg class="h-16 w-16 md:h-24 md:w-24 text-surface/30" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width={1} d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
              </div>
            )}
          </div>
          <div class="absolute -bottom-4 -right-4 h-16 w-16 md:h-24 md:w-24 rounded-full bg-secondary/10 -z-10"></div>
        </div>

        {/* Info */}
        <div class="lg:col-span-2 text-center lg:text-left">
          {prof.especialidad && (
            <span class="inline-block rounded-full bg-white/10 backdrop-blur-sm border border-white/20 px-4 py-1.5 md:px-5 md:py-2 text-xs md:text-sm font-medium text-primary mb-4 md:mb-6 font-body">
              {prof.especialidad.nombre}
            </span>
          )}
          <h1 class="text-3xl md:text-5xl font-bold tracking-tight text-white sm:text-4xl lg:text-7xl font-display leading-tight">
            {prof.nombre}
          </h1>
          <p class="mt-4 md:mt-8 text-base md:text-xl leading-relaxed text-white/70 font-body font-light max-w-2xl">
            {prof.biografia}
          </p>
          <div class="mt-6 md:mt-10 flex flex-col sm:flex-row items-stretch sm:items-center gap-3 md:gap-4 justify-center lg:justify-start">
            <a
              href={prof.enlaceAgenda}
              target="_blank"
              rel="noopener noreferrer"
              class="group inline-flex items-center justify-center rounded-full bg-primary px-6 py-3 md:px-8 md:py-4 text-base md:text-lg font-semibold text-white shadow-lg transition-all duration-500 hover:bg-primary/90 hover:shadow-glow hover:-translate-y-1 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:ring-offset-text font-body"
            >
              <svg class="mr-2 h-5 w-5 transition-transform duration-300 group-hover:rotate-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              Reservar Turno
            </a>
            <a
              href="/equipo"
              class="group inline-flex items-center justify-center rounded-full border border-white/30 px-6 py-3 md:px-8 md:py-4 text-base md:text-lg font-medium text-white transition-all duration-500 hover:border-white hover:bg-white/10 hover:-translate-y-1 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-text font-body"
            >
              Ver todo el equipo
              <svg class="ml-2 h-5 w-5 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>

          {/* Social links */}
          {(prof.facebook || prof.instagram) && (
            <div class="mt-6 md:mt-8 flex items-center gap-3 md:gap-4 justify-center lg:justify-start">
              <span class="text-sm text-white/40 font-body">Seguí en:</span>
              {prof.facebook && (
                <a
                  href={prof.facebook}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex h-10 w-10 md:h-12 md:w-12 items-center justify-center rounded-full bg-white/10 text-white transition-all duration-300 hover:bg-[#1877F2] hover:text-white hover:scale-110"
                  aria-label={`Facebook de ${prof.nombre}`}
                >
                  <svg class="h-4 w-4 md:h-5 md:w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                  </svg>
                </a>
              )}
              {prof.instagram && (
                <a
                  href={prof.instagram}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex h-10 w-10 md:h-12 md:w-12 items-center justify-center rounded-full bg-white/10 text-white transition-all duration-300 hover:bg-gradient-to-br hover:from-[#f09433] hover:via-[#dc2743] hover:to-[#bc1888] hover:text-white hover:scale-110"
                  aria-label={`Instagram de ${prof.nombre}`}
                >
                  <svg class="h-4 w-4 md:h-5 md:w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
                  </svg>
                </a>
              )}
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

</Layout>
