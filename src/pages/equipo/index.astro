---
import Layout from "../../layouts/Layout.astro";
import TeamFilters from "../../components/react/TeamFilters";
import { client } from "../../lib/sanity";
import { queries } from "../../lib/queries";
import { getImageUrl } from "../../lib/images";
import type { Configuracion, Profesional, Especialidad, EquipoPage } from "../../types";

const [config, profesionalesRaw, especialidades, equipoPage] = await Promise.all([
  client.fetch<Configuracion | null>(queries.configuracion).catch(() => null),
  client.fetch<Profesional[]>(queries.todosProfesionales).catch(() => []),
  client.fetch<Especialidad[]>(queries.todasEspecialidades).catch(() => []),
  client.fetch<EquipoPage | null>(queries.equipoPage).catch(() => null),
]);

// Demo professionals when no data
const demoProfesionales: Profesional[] = [
  {
    _id: "1",
    nombre: "Dra. Ana Martínez",
    slug: "ana-martinez",
    foto: {
      asset: {
        _id: "",
        url: "https://images.unsplash.com/photo-1559839734-2b71ea197ec2?auto=format&fit=crop&q=80&w=400",
      },
      alt: "Dra. Ana Martínez",
    },
    especialidades: [{ _id: "1", nombre: "Cardiología", slug: "cardiologia" }],
    enlaceAgenda: "#",
    biografia:
      "Especialista en cardiología intervencionista con más de 15 años de experiencia. Formada en la Universidad de Buenos Aires.",
  },
  {
    _id: "2",
    nombre: "Dr. Carlos Rodríguez",
    slug: "carlos-rodriguez",
    foto: {
      asset: {
        _id: "",
        url: "https://images.unsplash.com/photo-1612349317150-e413f6a5b16d?auto=format&fit=crop&q=80&w=400",
      },
      alt: "Dr. Carlos Rodríguez",
    },
    especialidades: [{ _id: "2", nombre: "Traumatología", slug: "traumatologia" }],
    enlaceAgenda: "#",
    biografia:
      "Cirujano ortopédico especializado en artroscopia y cirugía deportiva. Ex médico de selecciones nacionales.",
  },
  {
    _id: "3",
    nombre: "Dra. Laura Fernández",
    slug: "laura-fernandez",
    foto: {
      asset: {
        _id: "",
        url: "https://images.unsplash.com/photo-1594824476967-48c8b964273f?auto=format&fit=crop&q=80&w=400",
      },
      alt: "Dra. Laura Fernández",
    },
    especialidades: [{ _id: "3", nombre: "Dermatología", slug: "dermatologia" }],
    enlaceAgenda: "#",
    biografia:
      "Dermatóloga con enfoque en dermatología estética y tratamientos láser. Miembro de la Sociedad Argentina de Dermatología.",
  },
  {
    _id: "4",
    nombre: "Dr. Martín López",
    slug: "martin-lopez",
    foto: {
      asset: {
        _id: "",
        url: "https://images.unsplash.com/photo-1622253692010-333f2da6031d?auto=format&fit=crop&q=80&w=400",
      },
      alt: "Dr. Martín López",
    },
    especialidades: [{ _id: "4", nombre: "Pediatría", slug: "pediatria" }],
    enlaceAgenda: "#",
    biografia:
      "Pediatra dedicado con especialización en neonatología. Conocido por su trato cálido y profesional con los más pequeños.",
  },
  {
    _id: "5",
    nombre: "Dra. Sofía Gómez",
    slug: "sofia-gomez",
    foto: {
      asset: {
        _id: "",
        url: "https://images.unsplash.com/photo-1651008376811-b90baee60c1f?auto=format&fit=crop&q=80&w=400",
      },
      alt: "Dra. Sofía Gómez",
    },
    especialidades: [{ _id: "5", nombre: "Ginecología", slug: "ginecologia" }],
    enlaceAgenda: "#",
    biografia:
      "Ginecóloga y obstetra con amplia experiencia en salud reproductiva y medicina fetal.",
  },
  {
    _id: "6",
    nombre: "Dr. Pablo Silva",
    slug: "pablo-silva",
    foto: {
      asset: {
        _id: "",
        url: "https://images.unsplash.com/photo-1537368910025-700350fe46c7?auto=format&fit=crop&q=80&w=400",
      },
      alt: "Dr. Pablo Silva",
    },
    especialidades: [{ _id: "6", nombre: "Neurología", slug: "neurologia" }],
    enlaceAgenda: "#",
    biografia:
      "Neurólogo especializado en trastornos del movimiento y epilepsia. Investigador activo en neurociencias.",
  },
];

const profesionales =
  profesionalesRaw.length > 0 ? profesionalesRaw : demoProfesionales;

// Ordenar por apellido (quita prefijos profesionales)
const PREFIXES = ['dr.', 'dra.', 'lic.', 'psic.', 'profesora', 'profesor', 'prof.', 'mgtr.', 'mag.'];
function getSortKey(nombre: string): string {
  const words = nombre.trim().split(/\s+/);
  let start = 0;
  if (words.length > 0 && PREFIXES.includes(words[0].toLowerCase())) {
    start = 1;
  }
  return words.slice(start, words.length - 1).join(' ').toLowerCase();
}
const profesionalesSorted = [...profesionales].sort((a, b) => {
  return getSortKey(a.nombre).localeCompare(getSortKey(b.nombre), 'es');
});

// Preparar datos con URLs
const profesionalesConUrls: Profesional[] = profesionalesSorted.map((prof) => ({
  ...prof,
  foto: prof.foto?.asset
    ? {
        asset: {
          _id: prof.foto.asset._id,
          url: getImageUrl(prof.foto.asset.url, { w: 800, h: 800, fit: 'crop' }) || "",
        },
        alt: prof.foto.alt,
      }
    : undefined,
}));
---

<Layout
  title={equipoPage?.seo?.seoTitle || equipoPage?.hero?.titulo || 'Nuestro Equipo'}
  description={equipoPage?.seo?.seoDescription || equipoPage?.hero?.descripcion || 'Conocé al equipo médico de GO Centro Médico. Especialistas de excelencia en diversas áreas de la salud.'}
  image={equipoPage?.seo?.seoImage?.asset?.url}
  imageAlt={equipoPage?.seo?.seoImage?.alt}
  config={config}
  noIndex={equipoPage?.seo?.noIndex || false}
>
  <Fragment slot="head">
    {equipoPage?.hero?.imagenFondo && (
      <link 
        rel="preload" 
        as="image" 
        href={getImageUrl(equipoPage.hero.imagenFondo.asset?.url, { w: 800 })} 
        media="(max-width: 768px)"
        fetchpriority="high" 
      />
    )}
  </Fragment>

  {/* Hero interno */}
  <section class="relative bg-text py-32 lg:py-40 overflow-hidden">
    <div class="absolute inset-0">
      <picture>
        <source media="(max-width: 768px)" srcset={getImageUrl(equipoPage?.hero?.imagenFondo?.asset?.url, { w: 800 }) || "https://images.unsplash.com/photo-1579684385127-1ef15d508118?auto=format&fit=crop&q=80&w=800"} />
        <source media="(min-width: 769px)" srcset={getImageUrl(equipoPage?.hero?.imagenFondo?.asset?.url, { w: 1920 }) || "https://images.unsplash.com/photo-1579684385127-1ef15d508118?auto=format&fit=crop&q=80&w=1920"} />
        <img
          src={getImageUrl(equipoPage?.hero?.imagenFondo?.asset?.url, { w: 1920 }) || "https://images.unsplash.com/photo-1579684385127-1ef15d508118?auto=format&fit=crop&q=80&w=1920"}
          alt={equipoPage?.hero?.imagenFondo?.alt || "Equipo médico"}
          class="h-full w-full object-cover opacity-10"
          fetchpriority="high"
          loading="eager"
        />
      </picture>
      <div
        class="absolute inset-0 bg-gradient-to-br from-text via-text to-primary/20"
      >
      </div>
    </div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
      <span
        class="inline-block text-sm font-semibold uppercase tracking-[0.2em] text-primary mb-4 font-body"
        >{equipoPage?.hero?.badge || "Profesionales"}</span
      >
      <h1
        class="text-5xl font-bold tracking-tight text-white sm:text-6xl lg:text-7xl font-display leading-tight"
      >
        {equipoPage?.hero?.titulo || "Nuestro"} <span class="text-gradient">{equipoPage?.hero?.tituloDestacado || "Equipo Médico"}</span>
      </h1>
      <p
        class="mx-auto mt-6 max-w-2xl text-lg text-white/60 leading-relaxed font-body font-light"
      >
        {equipoPage?.hero?.descripcion || "Un equipo multidisciplinario de excelencia, comprometido con tu salud y bienestar."}
      </p>
    </div>
  </section>

  {/* Filters + Grid */}
  <section class="py-28 bg-background">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <TeamFilters
        profesionales={profesionalesConUrls}
        especialidades={especialidades}
        client:load
      />
    </div>
  </section>

  <script is:inline>
    function restoreScroll() {
      if (window.location.pathname !== '/equipo') return;
      const saved = window.sessionStorage.getItem('equipo-scroll');
      if (saved) {
        window.scrollTo({ top: parseInt(saved, 10), behavior: 'instant' });
        window.sessionStorage.removeItem('equipo-scroll');
      }
    }
    document.addEventListener('astro:page-load', restoreScroll);
  </script>
</Layout>
