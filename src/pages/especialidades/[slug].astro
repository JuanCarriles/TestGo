---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import { client } from '../../lib/sanity';
import { queries } from '../../lib/queries';
import { getImageUrl } from '../../lib/images';

const { slug } = Astro.params;

if (!slug) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const especialidad = await client.fetch<Especialidad | null>(queries.especialidadBySlug, { slug }).catch(() => null);

if (!especialidad || especialidad.activo === false) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const [config, profesionales] = await Promise.all([
  client.fetch<Configuracion | null>(queries.configuracion).catch(() => null),
  client.fetch<Profesional[]>(queries.profesionalesByEspecialidad, { slug }).catch(() => []),
]);

// Ordenar por apellido (quita prefijos profesionales)
const PREFIXES = ['dr.', 'dra.', 'lic.', 'psic.', 'profesora', 'profesor', 'prof.', 'mgtr.', 'mag.'];
function getSortKey(nombre: string): string {
  const words = nombre.trim().split(/\s+/);
  let start = 0;
  if (words.length > 0 && PREFIXES.includes(words[0].toLowerCase())) {
    start = 1;
  }
  return words.slice(start, words.length - 1).join(' ').toLowerCase();
}
const profesionalesSorted = [...profesionales].sort((a, b) => {
  return getSortKey(a.nombre).localeCompare(getSortKey(b.nombre), 'es');
});

const metaDescription = especialidad.seo?.seoDescription || `Conocé la especialidad de ${especialidad.nombre} en GO Centro Médico. ${especialidad.descripcion.slice(0, 120)}...`;
const metaTitle = especialidad.seo?.seoTitle || especialidad.nombre;
const ogImage = especialidad.seo?.seoImage?.asset?.url;
const noIndex = especialidad.seo?.noIndex || false;

// BreadcrumbList schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Inicio",
      "item": "https://gogineco.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Especialidades",
      "item": "https://gogineco.com/especialidades/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": especialidad.nombre,
      "item": `https://gogineco.com/especialidades/${especialidad.slug}/`
    }
  ]
};
---

<Layout
  title={metaTitle}
  description={metaDescription}
  image={ogImage}
  imageAlt={especialidad.seo?.seoImage?.alt}
  config={config}
  noIndex={noIndex}
  ogType="article"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <Breadcrumbs
    items={[
      { label: 'Especialidades', href: '/especialidades' },
      { label: especialidad.nombre },
    ]}
  />

  {/* Hero interno */}
  <section class="relative bg-text py-32 lg:py-40 overflow-hidden">
    <div class="absolute inset-0">
      <img
        src={especialidad.icono?.asset?.url || "https://images.unsplash.com/photo-1579684385127-1ef15d508118?auto=format&fit=crop&q=80&w=2000"}
        alt={especialidad.icono?.alt || especialidad.nombre}
        class="h-full w-full object-cover opacity-10"
      />
      <div class="absolute inset-0 bg-gradient-to-br from-text via-text to-primary/20"></div>
    </div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-5xl font-bold tracking-tight text-white sm:text-6xl lg:text-7xl font-display leading-tight">
        {especialidad.nombre}
      </h1>
    </div>
  </section>

  {/* Description */}
  <section class="py-20 bg-background">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-xl leading-relaxed text-text/60 font-body font-light">
        {especialidad.descripcion}
      </p>
    </div>
  </section>

  {/* Profesionales asociados */}
  {profesionalesSorted.length > 0 && (
  <section class="py-28 bg-surface/5 overflow-hidden">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-20">
        <span class="inline-block text-sm font-semibold uppercase tracking-[0.2em] text-primary mb-4 font-body">Equipo</span>
        <h2 class="text-5xl font-bold tracking-tight text-text sm:text-6xl font-display">
          Profesionales en <span class="text-gradient">{especialidad.nombre}</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {profesionalesSorted.map((prof) => (
          <div
            class="doctor-card group relative flex flex-col rounded-3xl border border-text/5 bg-white overflow-hidden transition-all duration-500 hover:-translate-y-2 hover:shadow-xl hover:border-primary/10 cursor-pointer"
            data-href={`/equipo/${prof.slug}`}
          >
            <div class="relative h-72 overflow-hidden">
              {prof.foto?.asset?.url ? (
                <img
                  src={getImageUrl(prof.foto.asset.url)}
                  alt={prof.foto.alt || prof.nombre}
                  class="h-full w-full object-cover object-center transition-transform duration-700 group-hover:scale-110"
                  loading="lazy"
                />
              ) : (
                <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-surface/20 to-primary/5">
                  <svg class="h-20 w-20 text-surface/30" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                  </svg>
                </div>
              )}
              <div class="absolute inset-0 bg-gradient-to-t from-text/60 via-transparent to-transparent"></div>
              {prof.especialidad && (
                <div class="absolute left-5 top-5 flex flex-wrap gap-2">
                  {(prof.especialidades && prof.especialidades.length > 0
                    ? prof.especialidades
                    : prof.especialidad ? [prof.especialidad] : []
                  ).map((esp) => (
                    <span class="rounded-full bg-white/90 backdrop-blur-sm px-4 py-1.5 text-xs font-semibold text-primary shadow-lg font-body">
                      {esp.nombre}
                    </span>
                  ))}
                </div>
              )}
            </div>

            <div class="flex flex-1 flex-col p-8">
              <h3 class="text-2xl font-semibold text-text group-hover:text-primary transition-colors duration-500 font-display">
                {prof.nombre}
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-text/50 line-clamp-3 flex-1 font-body font-light whitespace-pre-line">
                {prof.biografia}
              </p>
              <div class="mt-6 flex flex-col gap-3">
                <a
                  href={`/equipo/${prof.slug}`}
                  class="inline-flex items-center justify-center rounded-full border border-primary px-6 py-3 text-sm font-semibold text-primary transition-all duration-500 hover:bg-primary hover:text-white hover:shadow-glow focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 font-body"
                >
                  <svg class="mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                  </svg>
                  Ver Perfil
                </a>
                <a
                  href={prof.enlaceAgenda && prof.enlaceAgenda !== '#' ? prof.enlaceAgenda : prof.whatsapp ? `https://wa.me/${prof.whatsapp}?text=${encodeURIComponent(`Hola, quiero reservar un turno con el Dr/a. ${prof.nombre}.\n\nPara asignar y cotizar el turno, completá los siguientes datos:\n\nNombre completo:\nDNI:\nObra social:\n\nAdjuntar foto del pedido médico.\n\nGracias!`)}` : '#'}
                  target="_blank"
                  rel="noopener noreferrer"
                  onclick={`gtag('event', 'reservar_turno', { event_category: 'conversion', event_label: 'lista_especialidad', doctor_name: '${prof.nombre.replace(/'/g, "\\'")}' })`}
                  class="inline-flex items-center justify-center rounded-full bg-primary px-6 py-3 text-sm font-semibold text-white shadow-md transition-all duration-500 hover:bg-primary/90 hover:shadow-glow hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 font-body"
                >
                  <svg class="mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                  </svg>
                  Agendar Turno
                </a>
              </div>
            </div>

            <div class="h-1 bg-gradient-to-r from-primary to-secondary transform scale-x-0 origin-left transition-transform duration-500 group-hover:scale-x-100"></div>
          </div>
        ))}
      </div>
    </div>
  </section>
  )}

  {especialidad.especialidadesRelacionadas && especialidad.especialidadesRelacionadas.length > 0 && (
    <section class="py-20 bg-surface/5 border-t border-text/5">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-text font-display">
            Especialidades <span class="text-gradient">relacionadas</span>
          </h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
          {especialidad.especialidadesRelacionadas.map((rel) => (
            <a
              href={`/especialidades/${rel.slug}`}
              class="group card-glow relative flex flex-col rounded-3xl border border-text/5 bg-white overflow-hidden focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2"
            >
              <div class="relative h-56 overflow-hidden img-zoom">
                <img
                  src={rel.icono?.asset?.url || "https://images.unsplash.com/photo-1505751172876-fa1923c5c528?auto=format&fit=crop&q=80&w=600"}
                  alt={rel.icono?.alt || rel.nombre}
                  class="h-full w-full object-cover"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-text/60 via-text/20 to-transparent"></div>
              </div>
              <div class="flex flex-col flex-1 p-6 sm:p-8">
                <h3 class="text-xl font-semibold text-text group-hover:text-primary transition-colors duration-500 font-display">
                  {rel.nombre}
                </h3>
                <div class="mt-4 flex items-center text-sm font-semibold text-primary font-body">
                  <span>Ver especialidad</span>
                  <svg class="ml-2 h-4 w-4 transition-transform duration-500 group-hover:translate-x-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                  </svg>
                </div>
              </div>
              <div class="h-1 bg-gradient-to-r from-primary to-secondary transform scale-x-0 origin-left transition-transform duration-500 group-hover:scale-x-100"></div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* CTA Back */}
  <section class="py-20 bg-background">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
      <a
        href="/especialidades"
        class="group inline-flex items-center justify-center rounded-full border-2 border-text/10 px-8 py-4 text-base font-semibold text-text transition-all duration-500 hover:border-primary hover:text-primary focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 font-body"
      >
        <svg class="mr-2 h-5 w-5 transition-transform duration-300 group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Ver todas las especialidades
      </a>
    </div>
  </section>

  {/* CTA Section */}
  <section class="py-20 bg-surface/5 border-t border-text/5">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-lg text-text/60 font-body font-light mb-6">
        ¿Buscás un especialista? Conocé todo nuestro equipo médico.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/equipo"
          class="group inline-flex items-center justify-center rounded-full bg-primary px-8 py-4 text-base font-semibold text-white shadow-lg transition-all duration-500 hover:bg-primary/90 hover:shadow-glow hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 font-body"
        >
          Conocer el equipo
          <svg class="ml-2 h-5 w-5 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
        <a
          href="/especialidades"
          class="group inline-flex items-center justify-center rounded-full border-2 border-text/10 px-8 py-4 text-base font-semibold text-text transition-all duration-500 hover:border-primary hover:text-primary focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 font-body"
        >
          <svg class="mr-2 h-5 w-5 transition-transform duration-300 group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
          Ver todas las especialidades
        </a>
      </div>
    </div>
  </section>

  <script is:inline>
    function initDoctorCards() {
      document.querySelectorAll('.doctor-card').forEach(function(card) {
        card.addEventListener('click', function(e) {
          if (e.target.closest('a') || e.target.closest('button')) return;
          var href = card.getAttribute('data-href');
          if (href) window.location.href = href;
        });
      });
    }
    initDoctorCards();
    document.addEventListener('astro:page-load', initDoctorCards);
  </script>
</Layout>
