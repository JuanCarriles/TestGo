---
import Layout from '../../layouts/Layout.astro';
import { client } from '../../lib/sanity';
import { queries } from '../../lib/queries';
import type { Configuracion, Especialidad, Profesional } from '../../types';

export async function getStaticPaths() {
  const especialidades = await client.fetch<Especialidad[]>(queries.todasEspecialidades).catch(() => []);

  return especialidades.map((esp) => ({
    params: { slug: esp.slug },
    props: { especialidad: esp },
  }));
}

interface Props {
  especialidad: Especialidad;
}

const { especialidad } = Astro.props;
const { slug } = Astro.params;

const [config, profesionales] = await Promise.all([
  client.fetch<Configuracion | null>(queries.configuracion).catch(() => null),
  client.fetch<Profesional[]>(queries.profesionalesByEspecialidad, { slug }).catch(() => []),
]);

const metaDescription = `Conocé la especialidad de ${especialidad.nombre} en GO Centro Médico. ${especialidad.descripcion.slice(0, 120)}...`;

// Demo professionals
const demoProfesionales: Profesional[] = [
  {
    _id: '1',
    nombre: 'Dra. Ana Martínez',
    slug: 'ana-martinez',
    foto: { asset: { _id: '', url: 'https://images.unsplash.com/photo-1559839734-2b71ea197ec2?auto=format&fit=crop&q=80&w=400' }, alt: 'Dra. Ana Martínez' },
    especialidad: { _id: '1', nombre: especialidad.nombre, slug: especialidad.slug },
    enlaceAgenda: '#',
    biografia: 'Especialista con más de 15 años de experiencia. Formada en la Universidad de Buenos Aires con posgrados internacionales.',
  },
  {
    _id: '2',
    nombre: 'Dr. Juan Pérez',
    slug: 'juan-perez',
    foto: { asset: { _id: '', url: 'https://images.unsplash.com/photo-1612349317150-e413f6a5b16d?auto=format&fit=crop&q=80&w=400' }, alt: 'Dr. Juan Pérez' },
    especialidad: { _id: '2', nombre: especialidad.nombre, slug: especialidad.slug },
    enlaceAgenda: '#',
    biografia: 'Médico especialista con amplia trayectoria en el sector. Reconocido por su dedicación y trato humano con los pacientes.',
  },
];

const displayProfesionales = profesionales.length > 0 ? profesionales : demoProfesionales;
---

<Layout
  title={especialidad.nombre}
  description={metaDescription}
  config={config}
>
  {/* Hero interno */}
  <section class="relative bg-text py-32 lg:py-40 overflow-hidden">
    <div class="absolute inset-0">
      <img
        src="https://images.unsplash.com/photo-1579684385127-1ef15d508118?auto=format&fit=crop&q=80&w=2000"
        alt={especialidad.nombre}
        class="h-full w-full object-cover opacity-10"
      />
      <div class="absolute inset-0 bg-gradient-to-br from-text via-text to-primary/20"></div>
    </div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.2em] text-primary mb-4 font-body">
        <a href="/especialidades" class="hover:underline transition-all">Especialidades</a>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
        <span>{especialidad.nombre}</span>
      </span>
      <h1 class="text-5xl font-bold tracking-tight text-white sm:text-6xl lg:text-7xl font-display leading-tight">
        {especialidad.nombre}
      </h1>
    </div>
  </section>

  {/* Description */}
  <section class="py-20 bg-background">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-xl leading-relaxed text-text/60 font-body font-light">
        {especialidad.descripcion}
      </p>
    </div>
  </section>

  {/* Profesionales asociados */}
  <section class="py-28 bg-surface/5 overflow-hidden">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-20">
        <span class="inline-block text-sm font-semibold uppercase tracking-[0.2em] text-primary mb-4 font-body">Equipo</span>
        <h2 class="text-5xl font-bold tracking-tight text-text sm:text-6xl font-display">
          Profesionales en <span class="text-gradient">{especialidad.nombre}</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {displayProfesionales.map((prof) => (
          <div class="group relative flex flex-col rounded-3xl border border-text/5 bg-white overflow-hidden transition-all duration-500 hover:-translate-y-2 hover:shadow-xl hover:border-primary/10">
            <div class="relative h-72 overflow-hidden">
              {prof.foto?.asset?.url ? (
                <img
                  src={prof.foto.asset.url}
                  alt={prof.foto.alt || prof.nombre}
                  class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
                  loading="lazy"
                />
              ) : (
                <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-surface/20 to-primary/5">
                  <svg class="h-20 w-20 text-surface/30" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                  </svg>
                </div>
              )}
              <div class="absolute inset-0 bg-gradient-to-t from-text/60 via-transparent to-transparent"></div>
            </div>

            <div class="flex flex-1 flex-col p-8">
              <h3 class="text-2xl font-semibold text-text group-hover:text-primary transition-colors duration-500 font-display">
                {prof.nombre}
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-text/50 line-clamp-3 flex-1 font-body font-light">
                {prof.biografia}
              </p>
              <a
                href={prof.enlaceAgenda}
                target="_blank"
                rel="noopener noreferrer"
                className="mt-6 inline-flex items-center justify-center rounded-full bg-primary px-6 py-3 text-sm font-semibold text-white shadow-md transition-all duration-500 hover:bg-primary/90 hover:shadow-glow hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 font-body"
              >
                <svg class="mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
                Agendar Turno
              </a>
            </div>

            <div class="h-1 bg-gradient-to-r from-primary to-secondary transform scale-x-0 origin-left transition-transform duration-500 group-hover:scale-x-100"></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* CTA Back */}
  <section class="py-20 bg-background">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
      <a
        href="/especialidades"
        class="group inline-flex items-center justify-center rounded-full border-2 border-text/10 px-8 py-4 text-base font-semibold text-text transition-all duration-500 hover:border-primary hover:text-primary focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 font-body"
      >
        <svg class="mr-2 h-5 w-5 transition-transform duration-300 group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Ver todas las especialidades
      </a>
    </div>
  </section>
</Layout>
