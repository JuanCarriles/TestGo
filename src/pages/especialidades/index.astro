---
import Layout from '../../layouts/Layout.astro';
import { client } from '../../lib/sanity';
import { queries } from '../../lib/queries';
import type { Configuracion, Especialidad } from '../../types';

const [config, especialidades] = await Promise.all([
  client.fetch<Configuracion | null>(queries.configuracion).catch(() => null),
  client.fetch<Especialidad[]>(queries.todasEspecialidades).catch(() => []),
]);
---

<Layout
  title="Especialidades"
  description="Conocé todas las especialidades médicas de GO Centro Médico. Atención integral para tu salud y la de tu familia."
  config={config}
>
  {/* Hero interno */}
  <section class="relative bg-text py-24 lg:py-32">
    <div class="absolute inset-0 bg-gradient-to-br from-text via-text to-primary/20"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
      <span class="text-sm font-semibold uppercase tracking-wider text-primary">Servicios</span>
      <h1 class="mt-4 text-4xl font-bold tracking-tight text-white sm:text-5xl lg:text-6xl">
        Nuestras <span class="text-primary">Especialidades</span>
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-white/70 leading-relaxed">
        Atención médica integral con los mejores especialistas en cada área de la salud.
      </p>
    </div>
  </section>

  {/* Grid */}
  <section class="py-24 bg-background">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      {especialidades.length > 0 ? (
        <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {especialidades.map((esp) => (
            <a
              href={`/especialidades/${esp.slug}`}
              class="group flex flex-col rounded-2xl border border-text/5 bg-surface/5 p-8 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:bg-surface/10 hover:border-surface/20 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2"
            >
              <div class="mb-6 inline-flex h-14 w-14 items-center justify-center rounded-xl bg-primary/10 text-primary transition-colors duration-300 group-hover:bg-primary group-hover:text-white">
                {esp.icono?.asset?.url ? (
                  <img
                    src={esp.icono.asset.url}
                    alt={esp.icono.alt || esp.nombre}
                    class="h-8 w-8 object-contain"
                    loading="lazy"
                  />
                ) : (
                  <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                  </svg>
                )}
              </div>
              <h2 class="text-xl font-semibold text-text group-hover:text-primary transition-colors duration-300">
                {esp.nombre}
              </h2>
              <p class="mt-3 text-sm leading-relaxed text-text/60 line-clamp-3 flex-1">
                {esp.descripcion}
              </p>
              <div class="mt-6 flex items-center text-sm font-medium text-primary">
                <span>Ver especialidad</span>
                <svg class="ml-2 h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="text-center py-12">
          <p class="text-text/40">Próximamente cargaremos nuestras especialidades.</p>
        </div>
      )}
    </div>
  </section>
</Layout>
