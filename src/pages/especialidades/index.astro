---
import Layout from '../../layouts/Layout.astro';
import { client } from '../../lib/sanity';
import { queries } from '../../lib/queries';
import type { Configuracion, Especialidad, EspecialidadesPage } from '../../types';

const [config, especialidades, especialidadesPage] = await Promise.all([
  client.fetch<Configuracion | null>(queries.configuracion).catch(() => null),
  client.fetch<Especialidad[]>(queries.todasEspecialidades).catch(() => []),
  client.fetch<EspecialidadesPage | null>(queries.especialidadesPage).catch(() => null),
]);

// Placeholder images
const placeholderImages: Record<string, string> = {
  'default': 'https://images.unsplash.com/photo-1505751172876-fa1923c5c528?auto=format&fit=crop&q=80&w=600',
  'cardiologia': 'https://images.unsplash.com/photo-1628348070889-cb656235b4eb?auto=format&fit=crop&q=80&w=600',
  'dermatologia': 'https://images.unsplash.com/photo-1576091160550-2173dba999ef?auto=format&fit=crop&q=80&w=600',
  'pediatria': 'https://images.unsplash.com/photo-1581056771107-24ca5f033842?auto=format&fit=crop&q=80&w=600',
  'ginecologia': 'https://images.unsplash.com/photo-1559757175-5700dde675bc?auto=format&fit=crop&q=80&w=600',
  'traumatologia': 'https://images.unsplash.com/photo-1612349317150-e413f6a5b16d?auto=format&fit=crop&q=80&w=600',
  'neurologia': 'https://images.unsplash.com/photo-1559757148-5c350d0d3c56?auto=format&fit=crop&q=80&w=600',
};

function getImageForSlug(slug: string): string {
  return placeholderImages[slug] || placeholderImages['default'];
}

// Demo data when no data
const demoEspecialidades: Especialidad[] = [
  { _id: '1', nombre: 'Cardiología', slug: 'cardiologia', descripcion: 'Diagnóstico y tratamiento de enfermedades del corazón y sistema cardiovascular con tecnología de última generación.' },
  { _id: '2', nombre: 'Dermatología', slug: 'dermatologia', descripcion: 'Cuidado integral de la piel, tratamientos estéticos y detección temprana de patologías cutáneas.' },
  { _id: '3', nombre: 'Pediatría', slug: 'pediatria', descripcion: 'Atención especializada para bebés, niños y adolescentes con un enfoque cálido y humano.' },
  { _id: '4', nombre: 'Ginecología', slug: 'ginecologia', descripcion: 'Salud integral de la mujer con profesionales de excelencia y tecnología avanzada.' },
  { _id: '5', nombre: 'Traumatología', slug: 'traumatologia', descripcion: 'Tratamiento de lesiones deportivas, fracturas y patologías del sistema músculo-esquelético.' },
  { _id: '6', nombre: 'Neurología', slug: 'neurologia', descripcion: 'Diagnóstico y tratamiento de trastornos del sistema nervioso con equipamiento de vanguardia.' },
];

const displayEspecialidades = especialidades.length > 0 ? especialidades : demoEspecialidades;
---

<Layout
  title={especialidadesPage?.seo?.seoTitle || especialidadesPage?.hero?.titulo || 'Especialidades'}
  description={especialidadesPage?.seo?.seoDescription || especialidadesPage?.hero?.descripcion || 'Conocé todas las especialidades médicas de GO Centro Médico. Atención integral para tu salud y la de tu familia.'}
  image={especialidadesPage?.seo?.seoImage?.asset?.url}
  imageAlt={especialidadesPage?.seo?.seoImage?.alt}
  config={config}
  noIndex={especialidadesPage?.seo?.noIndex || false}
>
  {/* Hero interno */}
  <section class="relative bg-text py-32 lg:py-40 overflow-hidden">
    <div class="absolute inset-0">
      <img
        src={especialidadesPage?.hero?.imagenFondo?.asset?.url || "https://images.unsplash.com/photo-1579684385127-1ef15d508118?auto=format&fit=crop&q=80&w=2000"}
        alt={especialidadesPage?.hero?.imagenFondo?.alt || "Especialidades médicas"}
        class="h-full w-full object-cover opacity-10"
      />
      <div class="absolute inset-0 bg-gradient-to-br from-text via-text to-primary/20"></div>
    </div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block text-sm font-semibold uppercase tracking-[0.2em] text-primary mb-4 font-body">Servicios</span>
      <h1 class="text-5xl font-bold tracking-tight text-white sm:text-6xl lg:text-7xl font-display leading-tight">
        Nuestras <span class="text-gradient">Especialidades</span>
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-white/60 leading-relaxed font-body font-light">
        Atención médica integral con los mejores especialistas en cada área de la salud.
      </p>
    </div>
  </section>

  {/* Grid */}
  <section class="py-28 bg-background overflow-hidden">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {displayEspecialidades.map((esp) => (
          <a
            href={`/especialidades/${esp.slug}`}
            class="group card-glow relative flex flex-col rounded-3xl border border-text/5 bg-white overflow-hidden focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2"
          >
            <div class="relative h-56 overflow-hidden img-zoom">
              <img
                src={esp.icono?.asset?.url || getImageForSlug(esp.slug)}
                alt={esp.icono?.alt || esp.nombre}
                class="h-full w-full object-cover"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-text/60 via-text/20 to-transparent"></div>
              <div class="absolute top-4 right-4 flex h-12 w-12 items-center justify-center rounded-2xl bg-white/90 backdrop-blur-sm text-primary shadow-lg transition-transform duration-500 group-hover:scale-110 group-hover:rotate-6">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                </svg>
              </div>
            </div>
            <div class="flex flex-col flex-1 p-8">
              <h2 class="text-2xl font-semibold text-text group-hover:text-primary transition-colors duration-500 font-display">
                {esp.nombre}
              </h2>
              <p class="mt-3 text-sm leading-relaxed text-text/50 line-clamp-3 flex-1 font-body font-light">
                {esp.descripcion}
              </p>
              <div class="mt-6 flex items-center text-sm font-semibold text-primary font-body">
                <span>Ver especialidad</span>
                <svg class="ml-2 h-4 w-4 transition-transform duration-500 group-hover:translate-x-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
              </div>
            </div>
            <div class="h-1 bg-gradient-to-r from-primary to-secondary transform scale-x-0 origin-left transition-transform duration-500 group-hover:scale-x-100"></div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
