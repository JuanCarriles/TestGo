---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import EspecialidadesGrid from '../components/sections/EspecialidadesGrid.astro';
import PorQueElegirnos from '../components/sections/PorQueElegirnos.astro';
import ObrasSociales from '../components/sections/ObrasSociales.astro';
import ContactoSection from '../components/sections/ContactoSection.astro';
import InstagramReelsCarousel from '../components/react/InstagramReelsCarousel';
import TestimoniosCarousel from '../components/react/TestimoniosCarousel';
import { client } from '../lib/sanity';
import { queries } from '../lib/queries';
import type { Configuracion, Especialidad, HomePage, InstagramReel, Testimonio } from '../types';

const [config, homePage, especialidades, instagramReels] = await Promise.all([
  client.fetch<Configuracion | null>(queries.configuracion).catch(() => null),
  client.fetch<HomePage | null>(queries.homePage).catch(() => null),
  client.fetch<Especialidad[]>(queries.todasEspecialidades).catch(() => []),
  client.fetch<InstagramReel[]>(queries.instagramReels).catch(() => []),
]);

const metaDescription = homePage?.seo?.seoDescription || config?.metaDescription || 'GO Centro Médico - Excelencia médica con atención personalizada las 24 horas. Reservá tu turno online con los mejores especialistas.';
const metaTitle = homePage?.seo?.seoTitle || 'Inicio';
const ogImage = homePage?.seo?.seoImage?.asset?.url;
const noIndex = homePage?.seo?.noIndex || false;
const instagramUrl = config?.redesSociales?.find((r) => r.nombre === 'instagram')?.url || '';

// Demo testimonials when no data
const demoTestimonios: Testimonio[] = [
  { nombre: 'María González', texto: 'La atención en GO Centro Médico es excepcional. Desde que llegué me sentí cuidada y escuchada. Los médicos son verdaderos profesionales.', estrellas: 5, fecha: '2024-03-15' },
  { nombre: 'Carlos Rodríguez', texto: 'Excelente servicio y modernas instalaciones. Pude agendar mi turno online sin problemas y la consulta fue muy completa.', estrellas: 5, fecha: '2024-02-20' },
  { nombre: 'Laura Martínez', texto: 'Llevé a mis hijos a la pediatría y quedé encantada con el trato. Un equipo humano y profesional que transmite confianza.', estrellas: 5, fecha: '2024-01-10' },
];

const displayTestimonios = homePage?.testimonios?.length ? homePage.testimonios : demoTestimonios;

// Aggregate rating from testimonials
const avgRating = displayTestimonios.length > 0
  ? (displayTestimonios.reduce((sum, t) => sum + (t.estrellas || 5), 0) / displayTestimonios.length)
  : 5;

// MedicalBusiness schema for the homepage
const medicalBusinessSchema = {
  "@context": "https://schema.org",
  "@type": ["MedicalBusiness", "LocalBusiness"],
  "name": config?.metaTitle || "GO Centro Médico",
  "description": config?.metaDescription || "Centro médico de excelencia en San Miguel de Tucumán",
  "url": "https://gocentromedico.com",
  "logo": config?.logo?.asset?.url,
  "image": ogImage || config?.ogImage?.asset?.url,
  "telephone": config?.telefono || config?.whatsapp,
  "email": config?.email,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": config?.direccion,
    "addressLocality": "San Miguel de Tucumán",
    "addressRegion": "Tucumán",
    "addressCountry": "AR"
  },
  "priceRange": "$$",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": avgRating.toFixed(1),
    "reviewCount": displayTestimonios.length.toString()
  }
};

const cleanBusinessSchema = JSON.parse(JSON.stringify(medicalBusinessSchema));
---

<Layout
  title={metaTitle}
  description={metaDescription}
  image={ogImage}
  imageAlt={homePage?.seo?.seoImage?.alt}
  config={config}
  noIndex={noIndex}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(cleanBusinessSchema)} />
  </Fragment>
  <HeroSection config={config} homePage={homePage} />
  <EspecialidadesGrid especialidades={especialidades} homePage={homePage} />
  <PorQueElegirnos homePage={homePage} />
  <ObrasSociales homePage={homePage} />
  {instagramReels.length > 0 && (
    <InstagramReelsCarousel reels={instagramReels} instagramUrl={instagramUrl} client:load />
  )}
  <TestimoniosCarousel testimonios={displayTestimonios} client:load />
  <ContactoSection homePage={homePage} />

  <script is:inline>
    (function() {
      var sent = false;
      function checkScroll() {
        if (sent) return;
        if ((window.innerHeight + window.scrollY) >= document.body.scrollHeight - 100) {
          sent = true;
          if (typeof gtag !== 'undefined') {
            gtag('event', 'scroll_final', { event_category: 'engagement', event_label: 'home' });
          }
        }
      }
      window.addEventListener('scroll', checkScroll, { passive: true });
      checkScroll();
    })();
  </script>
</Layout>
