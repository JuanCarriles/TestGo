---
import Layout from '../layouts/Layout.astro';
import { client } from '../lib/sanity';
import { queries } from '../lib/queries';
import type { Configuracion } from '../types';

const config = await client.fetch<Configuracion | null>(queries.configuracion).catch(() => null);

const valores = [
  {
    title: 'Excelencia',
    description: 'Buscamos la perfección en cada diagnóstico, tratamiento y experiencia de atención.',
  },
  {
    title: 'Compromiso',
    description: 'Nos dedicamos con pasión y responsabilidad a la salud y bienestar de cada paciente.',
  },
  {
    title: 'Innovación',
    description: 'Incorporamos constantemente tecnología de vanguardia y métodos actualizados.',
  },
  {
    title: 'Empatía',
    description: 'Escuchamos, comprendemos y acompañamos a nuestros pacientes en cada etapa.',
  },
];
---

<Layout
  title="Nosotros"
  description="Conocé la historia, misión, visión y valores de GO Centro Médico. Más de una década de excelencia en salud."
  config={config}
>
  {/* Hero interno */}
  <section class="relative bg-text py-32 lg:py-40 overflow-hidden">
    <div class="absolute inset-0">
      <img
        src="https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?auto=format&fit=crop&q=80&w=2000"
        alt="Fondo"
        class="h-full w-full object-cover opacity-10"
      />
      <div class="absolute inset-0 bg-gradient-to-br from-text via-text to-primary/20"></div>
    </div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block text-sm font-semibold uppercase tracking-[0.2em] text-primary mb-4 font-body">Sobre Nosotros</span>
      <h1 class="text-5xl font-bold tracking-tight text-white sm:text-6xl lg:text-7xl font-display leading-tight">
        Una historia de <span class="text-gradient">excelencia médica</span>
      </h1>
    </div>
  </section>

  {/* Historia */}
  <section class="py-28 bg-background overflow-hidden">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-20 lg:grid-cols-2 items-center">
        <div class="relative">
          <div class="relative rounded-3xl overflow-hidden shadow-2xl">
            <img
              src="https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?auto=format&fit=crop&q=80&w=800"
              alt="Instalaciones"
              class="h-[600px] w-full object-cover"
            />
          </div>
          {/* Floating badge */}
          <div class="absolute -bottom-8 -right-8 rounded-2xl bg-white shadow-xl border border-text/5 p-6">
            <p class="text-5xl font-bold text-primary font-display">15+</p>
            <p class="text-sm text-text/50 font-body mt-1">Años de trayectoria</p>
          </div>
          <div class="absolute -top-6 -left-6 h-32 w-32 rounded-full bg-secondary/10 -z-10"></div>
        </div>

        <div>
          <span class="inline-block text-sm font-semibold uppercase tracking-[0.2em] text-primary mb-4 font-body">Nuestra Historia</span>
          <h2 class="text-5xl font-bold tracking-tight text-text font-display leading-tight">
            Más de una década <span class="text-gradient">cuidando</span> de la comunidad
          </h2>
          <div class="mt-8 space-y-6 text-base leading-relaxed text-text/60 font-body font-light">
            <p>
              GO Centro Médico nació con una visión clara: ofrecer atención médica de alta calidad, accesible y humana.
              Desde nuestros inicios, nos propusimos crear un espacio donde la tecnología de vanguardia se encuentre con
              el trato personalizado que cada paciente merece.
            </p>
            <p>
              A lo largo de los años, fuimos creciendo y ampliando nuestras especialidades, incorporando profesionales
              de excelencia y equipamiento médico de última generación.
            </p>
            <p>
              Nuestro compromiso con la comunidad va más allá de la consulta médica. Participamos activamente en
              campañas de prevención, charlas educativas y programas de salud integral.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Misión, Visión */}
  <section class="py-28 bg-surface/5 overflow-hidden">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
        <div class="group rounded-3xl bg-white p-12 shadow-sm border border-text/5 transition-all duration-500 hover:shadow-xl hover:-translate-y-2">
          <div class="mb-8 inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-primary/10 text-primary transition-all duration-500 group-hover:bg-primary group-hover:text-white group-hover:shadow-glow">
            <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="text-3xl font-bold text-text font-display">Misión</h3>
          <p class="mt-6 text-base leading-relaxed text-text/50 font-body font-light">
            Brindar atención médica integral de excelencia, combinando tecnología de vanguardia con un equipo humano
            altamente calificado y comprometido. Priorizamos el bienestar de nuestros pacientes mediante un servicio
            accesible, personalizado y eficiente, promoviendo la prevención y el cuidado continuo de la salud.
          </p>
        </div>
        <div class="group rounded-3xl bg-white p-12 shadow-sm border border-text/5 transition-all duration-500 hover:shadow-xl hover:-translate-y-2">
          <div class="mb-8 inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-secondary/10 text-secondary transition-all duration-500 group-hover:bg-secondary group-hover:text-white group-hover:shadow-glow-secondary">
            <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
          </div>
          <h3 class="text-3xl font-bold text-text font-display">Visión</h3>
          <p class="mt-6 text-base leading-relaxed text-text/50 font-body font-light">
            Ser el centro médico de referencia en la región, reconocido por la calidad de nuestros servicios,
            la innovación constante y la satisfacción de nuestros pacientes. Aspiramos a expandir nuestra cobertura
            y especialidades, manteniendo siempre los más altos estándares de excelencia médica y humana.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* Valores */}
  <section class="py-28 bg-background overflow-hidden">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-20">
        <span class="inline-block text-sm font-semibold uppercase tracking-[0.2em] text-primary mb-4 font-body">Principios</span>
        <h2 class="text-5xl font-bold tracking-tight text-text sm:text-6xl font-display">
          Nuestros <span class="text-gradient">Valores</span>
        </h2>
        <p class="mt-6 text-lg text-text/50 max-w-2xl mx-auto font-body font-light">
          Los pilares que guían cada decisión y acción en GO Centro Médico.
        </p>
      </div>
      <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {valores.map((valor) => (
          <div class="group rounded-3xl bg-surface/5 p-10 text-center border border-text/5 transition-all duration-500 hover:-translate-y-2 hover:shadow-xl hover:border-primary/10 hover:bg-white">
            <h3 class="text-2xl font-semibold text-text group-hover:text-primary transition-colors duration-500 font-display">
              {valor.title}
            </h3>
            <p class="mt-4 text-sm leading-relaxed text-text/50 font-body font-light">
              {valor.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Galería */}
  <section class="py-28 bg-text overflow-hidden">
    <div class="absolute inset-0 noise-overlay opacity-20"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-20">
        <span class="inline-block text-sm font-semibold uppercase tracking-[0.2em] text-primary mb-4 font-body">Instalaciones</span>
        <h2 class="text-5xl font-bold tracking-tight text-white sm:text-6xl font-display">
          Conocé nuestras <span class="text-gradient">instalaciones</span>
        </h2>
      </div>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {[
          { src: 'https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?auto=format&fit=crop&q=80&w=600', titulo: 'Recepción' },
          { src: 'https://images.unsplash.com/photo-1581056771107-24ca5f033842?auto=format&fit=crop&q=80&w=600', titulo: 'Sala de Espera' },
          { src: 'https://images.unsplash.com/photo-1631217868264-e5b90bb7e133?auto=format&fit=crop&q=80&w=600', titulo: 'Consultorios' },
          { src: 'https://images.unsplash.com/photo-1579684385127-1ef15d508118?auto=format&fit=crop&q=80&w=600', titulo: 'Tecnología' },
          { src: 'https://images.unsplash.com/photo-1612349317150-e413f6a5b16d?auto=format&fit=crop&q=80&w=600', titulo: 'Equipamiento' },
          { src: 'https://images.unsplash.com/photo-1559757148-5c350d0d3c56?auto=format&fit=crop&q=80&w=600', titulo: 'Diagnóstico' },
        ].map((item) => (
          <div class="group relative aspect-[4/3] overflow-hidden rounded-3xl">
            <img
              src={item.src}
              alt={item.titulo}
              class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-text/80 via-text/20 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"></div>
            <div class="absolute inset-0 flex items-end p-6 opacity-0 translate-y-4 transition-all duration-500 group-hover:opacity-100 group-hover:translate-y-0">
              <p class="text-xl font-semibold text-white font-display">{item.titulo}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
