---
import Layout from "../layouts/Layout.astro";
import { client } from "../lib/sanity";
import { queries } from "../lib/queries";
import { getImageUrl } from "../lib/images";
import type {
  Configuracion,
  NosotrosPage,
  ImagenGaleria,
  Noticia,
} from "../types";
import GaleriaCarousel from "../components/react/GaleriaCarousel";
import NoticiasCarousel from "../components/react/NoticiasCarousel";

const [config, nosotros, noticias] = await Promise.all([
  client.fetch<Configuracion | null>(queries.configuracion).catch(() => null),
  client.fetch<NosotrosPage | null>(queries.nosotrosPage).catch(() => null),
  client.fetch<Noticia[]>(queries.ultimasNoticias).catch(() => []),
]);

const seo = nosotros?.seo;

// ── Defaults ──
const hero = nosotros?.hero;
const heroBadge = hero?.badge || "Sobre Nosotros";
const heroTitulo = hero?.titulo || "Una historia de excelencia médica";
const heroDestacado = hero?.tituloDestacado || "excelencia médica";
const heroImagen =
  hero?.imagenFondo?.asset?.url ||
  "https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?auto=format&fit=crop&q=80&w=2000";
const heroAlt = hero?.imagenFondo?.alt || "Fondo";

const historia = nosotros?.historia;
const histBadge = historia?.badge || "Nuestra Historia";
const histTitulo =
  historia?.titulo || "Más de una década cuidando a la comunidad";
const histDestacado = historia?.tituloDestacado || "cuidando a la comunidad";
const histVideoUrl = historia?.video?.asset?.url;
const histParrafos = historia?.parrafos || [
  "GO Centro Médico nació con una visión clara: ofrecer atención médica de alta calidad, accesible y humana. Desde nuestros inicios, nos propusimos crear un espacio donde la tecnología de vanguardia se encuentre con el trato personalizado que cada paciente merece.",
  "A lo largo de los años, fuimos creciendo y ampliando nuestras especialidades, incorporando profesionales de excelencia y equipamiento médico de última generación.",
  "Nuestro compromiso con la comunidad va más allá de la consulta médica. Participamos activamente en campañas de prevención, charlas educativas y programas de salud integral.",
];
const histTarjetaNumero = historia?.tarjetaFlotante?.numero || "15+";
const histTarjetaEtiqueta =
  historia?.tarjetaFlotante?.etiqueta || "Años de trayectoria";

const mv = nosotros?.misionVision;
const misionIcono = mv?.mision?.icono;
const misionTitulo = mv?.mision?.titulo || "Misión";
const misionDesc =
  mv?.mision?.descripcion ||
  "Brindar atención médica integral de excelencia, combinando tecnología de vanguardia con un equipo humano altamente calificado y comprometido. Priorizamos el bienestar de nuestros pacientes mediante un servicio accesible, personalizado y eficiente, promoviendo la prevención y el cuidado continuo de la salud.";
const visionIcono = mv?.vision?.icono;
const visionTitulo = mv?.vision?.titulo || "Visión";
const visionDesc =
  mv?.vision?.descripcion ||
  "Ser el centro médico de referencia en la región, reconocido por la calidad de nuestros servicios, la innovación constante y la satisfacción de nuestros pacientes. Aspiramos a expandir nuestra cobertura y especialidades, manteniendo siempre los más altos estándares de excelencia médica y humana.";

// Helper: convert **text** to <strong>text</strong>
function formatBold(text: string): string {
  return text.replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>");
}

const valores = nosotros?.valores;
const valBadge = valores?.badge || "Principios";
const valTitulo = valores?.titulo || "Nuestros Valores";
const valDestacado = valores?.tituloDestacado || "Valores";
const valDesc =
  valores?.descripcion ||
  "Los pilares que guían cada decisión y acción en GO Centro Médico.";
const valItems = valores?.items || [
  {
    titulo: "Excelencia",
    descripcion:
      "Buscamos la perfección en cada diagnóstico, tratamiento y experiencia de atención.",
  },
  {
    titulo: "Compromiso",
    descripcion:
      "Nos dedicamos con pasión y responsabilidad a la salud y bienestar de cada paciente.",
  },
  {
    titulo: "Innovación",
    descripcion:
      "Incorporamos constantemente tecnología de vanguardia y métodos actualizados.",
  },
  {
    titulo: "Empatía",
    descripcion:
      "Escuchamos, comprendemos y acompañamos a nuestros pacientes en cada etapa.",
  },
];

const galeria = nosotros?.galeria;
const galBadge = galeria?.badge || "Instalaciones";
const galTitulo = galeria?.titulo || "Conocé nuestras instalaciones";
const galDestacado = galeria?.tituloDestacado || "instalaciones";
const galImagenes: ImagenGaleria[] =
  galeria?.imagenes && galeria.imagenes.length > 0
    ? galeria.imagenes
    : [
        {
          imagen: {
            asset: {
              _id: "fallback-1",
              url: "https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?auto=format&fit=crop&q=80&w=600",
            },
            alt: "Recepción del centro médico",
          },
          titulo: "Recepción",
        },
        {
          imagen: {
            asset: {
              _id: "fallback-2",
              url: "https://images.unsplash.com/photo-1581056771107-24ca5f033842?auto=format&fit=crop&q=80&w=600",
            },
            alt: "Sala de espera",
          },
          titulo: "Sala de Espera",
        },
        {
          imagen: {
            asset: {
              _id: "fallback-3",
              url: "https://images.unsplash.com/photo-1631217868264-e5b90bb7e133?auto=format&fit=crop&q=80&w=600",
            },
            alt: "Consultorios médicos",
          },
          titulo: "Consultorios",
        },
        {
          imagen: {
            asset: {
              _id: "fallback-4",
              url: "https://images.unsplash.com/photo-1579684385127-1ef15d508118?auto=format&fit=crop&q=80&w=600",
            },
            alt: "Tecnología médica",
          },
          titulo: "Tecnología",
        },
        {
          imagen: {
            asset: {
              _id: "fallback-5",
              url: "https://images.unsplash.com/photo-1612349317150-e413f6a5b16d?auto=format&fit=crop&q=80&w=600",
            },
            alt: "Equipamiento médico",
          },
          titulo: "Equipamiento",
        },
        {
          imagen: {
            asset: {
              _id: "fallback-6",
              url: "https://images.unsplash.com/photo-1559757148-5c350d0d3c56?auto=format&fit=crop&q=80&w=600",
            },
            alt: "Diagnóstico por imágenes",
          },
          titulo: "Diagnóstico",
        },
      ];
---

<Layout
  title={seo?.seoTitle || "Nosotros"}
  description={seo?.seoDescription ||
    "Conocé la historia, misión, visión y valores de GO Centro Médico. Más de una década de excelencia en salud."}
  image={seo?.seoImage?.asset?.url}
  imageAlt={seo?.seoImage?.alt}
  config={config}
  noIndex={seo?.noIndex || false}
>
  {/* Hero interno */}
  <section class="relative bg-text py-20 sm:py-28 lg:py-40 overflow-hidden">
    <div class="absolute inset-0">
      <img
        src={heroImagen}
        alt={heroAlt}
        class="h-full w-full object-cover opacity-20 md:opacity-15"
      />
      <div
        class="absolute inset-0 bg-gradient-to-br from-text via-text/90 to-primary/30"
      >
      </div>
    </div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
      <span
        class="inline-block text-xs sm:text-sm font-semibold uppercase tracking-[0.2em] text-primary mb-3 sm:mb-4 font-body"
        >{heroBadge}</span
      >
      <h1
        class="text-3xl sm:text-5xl lg:text-7xl font-bold tracking-tight text-white font-display leading-tight"
      >
        {heroTitulo.split(heroDestacado)[0]}<span class="text-gradient"
          >{heroDestacado}</span
        >{heroTitulo.split(heroDestacado)[1] || ""}
      </h1>
    </div>
  </section>

  {/* Historia */}
  <section class="py-16 sm:py-20 lg:py-28 bg-background overflow-hidden">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div
        class="grid grid-cols-1 gap-12 lg:gap-20 lg:grid-cols-2 items-center"
      >
        <div class="relative order-1 lg:order-none">
          <div class="relative rounded-3xl overflow-hidden shadow-2xl">
            {
              histVideoUrl ? (
                <video
                  id="historia-video"
                  src={histVideoUrl}
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="auto"
                  class="aspect-[4/3] w-full object-cover"
                />
              ) : (
                <img
                  src="https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?auto=format&fit=crop&q=80&w=800"
                  alt="Instalaciones"
                  class="aspect-[4/3] w-full object-cover"
                />
              )
            }
          </div>
          {/* Floating badge */}
          <div
            class="absolute -bottom-4 -right-2 sm:-bottom-6 sm:-right-6 lg:-bottom-8 lg:-right-8 rounded-2xl bg-white shadow-xl border border-text/5 p-4 sm:p-5 lg:p-6"
          >
            <p
              class="text-3xl sm:text-4xl lg:text-5xl font-bold text-primary font-display"
            >
              {histTarjetaNumero}
            </p>
            <p class="text-xs sm:text-sm text-text/70 font-body mt-1">
              {histTarjetaEtiqueta}
            </p>
          </div>
          <div
            class="absolute -top-4 -left-4 sm:-top-6 sm:-left-6 h-20 w-20 sm:h-28 sm:w-28 lg:h-32 lg:w-32 rounded-full bg-secondary/10 -z-10"
          >
          </div>
        </div>

        <div class="order-2 lg:order-none">
          <span
            class="inline-block text-xs sm:text-sm font-semibold uppercase tracking-[0.2em] text-primary mb-3 sm:mb-4 font-body"
            >{histBadge}</span
          >
          <h2
            class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-text font-display leading-tight"
          >
            {histTitulo.split(histDestacado)[0]}<span class="text-gradient"
              >{histDestacado}</span
            >{histTitulo.split(histDestacado)[1] || ""}
          </h2>
          <div
            class="mt-6 lg:mt-8 space-y-4 sm:space-y-6 text-sm sm:text-base leading-relaxed text-text/60 font-body font-light"
          >
            {histParrafos.map((parrafo) => <p>{parrafo}</p>)}
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Misión, Visión */}
  <section class="py-16 sm:py-20 lg:py-28 bg-background overflow-hidden">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-6 sm:gap-8 lg:grid-cols-2">
        {/* Misión */}
        <div
          class="mv-card group relative rounded-3xl bg-gradient-to-br from-white via-white to-primary/[0.03] p-8 sm:p-10 lg:p-12 shadow-sm border border-text/5 transition-all duration-500 hover:shadow-xl hover:-translate-y-2 overflow-hidden"
        >
          {/* Decorative top accent */}
          <div
            class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-primary to-secondary opacity-0 group-hover:opacity-100 transition-opacity duration-500"
          >
          </div>

          {/* Elegant background decorations - MORE VISIBLE */}
          <div
            class="absolute top-0 right-0 w-64 h-64 opacity-[0.10] pointer-events-none transform translate-x-1/4 -translate-y-1/4"
          >
            <svg
              viewBox="0 0 200 200"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M100 180C100 180 20 130 20 70C20 40 45 20 70 20C85 20 95 30 100 40C105 30 115 20 130 20C155 20 180 40 180 70C180 130 100 180 100 180Z"
                fill="#CB6767"></path>
            </svg>
          </div>
          <div
            class="absolute bottom-0 left-0 w-48 h-48 opacity-[0.12] pointer-events-none transform -translate-x-1/4 translate-y-1/4"
          >
            <svg
              viewBox="0 0 200 200"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <circle
                cx="100"
                cy="100"
                r="80"
                stroke="#CB6767"
                stroke-width="1"
                stroke-dasharray="4 6"></circle>
              <circle
                cx="100"
                cy="100"
                r="60"
                stroke="#CB6767"
                stroke-width="1"
                stroke-dasharray="2 4"></circle>
              <circle cx="100" cy="100" r="40" stroke="#CB6767" stroke-width="1"
              ></circle>
            </svg>
          </div>
          <div
            class="absolute top-1/2 right-4 opacity-[0.10] pointer-events-none"
          >
            <svg width="60" height="60" viewBox="0 0 60 60" fill="none">
              <path
                d="M30 5C30 5 10 20 10 35C10 42 15 48 22 48C26 48 29 45 30 42C31 45 34 48 38 48C45 48 50 42 50 35C50 20 30 5 30 5Z"
                stroke="#CB6767"
                stroke-width="1.5"
                fill="none"></path>
            </svg>
          </div>

          {/* Icon */}
          {
            misionIcono?.asset?.url ? (
              <div class="mb-6 sm:mb-8 inline-flex h-14 w-14 sm:h-16 sm:w-16 items-center justify-center rounded-2xl bg-primary/5 border border-primary/10 transition-all duration-500 group-hover:bg-primary/10 group-hover:scale-110 group-hover:shadow-glow">
                <img
                  src={getImageUrl(misionIcono.asset.url)}
                  alt={misionIcono.alt || misionTitulo}
                  class="h-8 w-8 sm:h-10 sm:w-10 object-contain"
                />
              </div>
            ) : (
              <div class="mb-6 sm:mb-8 inline-flex h-14 w-14 sm:h-16 sm:w-16 items-center justify-center rounded-2xl bg-primary/10 text-primary transition-all duration-500 group-hover:bg-primary group-hover:text-white group-hover:shadow-glow">
                <svg
                  class="h-7 w-7 sm:h-8 sm:w-8"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M13 10V3L4 14h7v7l9-11h-7z"
                  />
                </svg>
              </div>
            )
          }

          <h3
            class="text-2xl sm:text-3xl lg:text-4xl font-bold text-text font-display tracking-tight"
          >
            {misionTitulo}
          </h3>
          <div
            class="mt-4 sm:mt-6 space-y-4 text-sm sm:text-base leading-relaxed text-text/60 font-body font-light text-justify"
          >
            {
              misionDesc
                .split("\n\n")
                .map((parrafo) => <p set:html={formatBold(parrafo)} />)
            }
          </div>
        </div>

        {/* Visión */}
        <div
          class="mv-card group relative rounded-3xl bg-gradient-to-br from-white via-white to-secondary/[0.03] p-8 sm:p-10 lg:p-12 shadow-sm border border-text/5 transition-all duration-500 hover:shadow-xl hover:-translate-y-2 overflow-hidden"
        >
          {/* Decorative top accent */}
          <div
            class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-secondary to-primary opacity-0 group-hover:opacity-100 transition-opacity duration-500"
          >
          </div>

          {/* Elegant background decorations - MORE VISIBLE */}
          <div
            class="absolute top-0 left-0 w-64 h-64 opacity-[0.10] pointer-events-none transform -translate-x-1/4 -translate-y-1/4"
          >
            <svg
              viewBox="0 0 200 200"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M100 20C120 60 160 80 160 120C160 150 130 170 100 170C70 170 40 150 40 120C40 80 80 60 100 20Z"
                stroke="#49B89B"
                stroke-width="2"
                fill="none"></path>
              <path
                d="M100 40C115 70 140 85 140 115C140 135 120 150 100 150C80 150 60 135 60 115C60 85 85 70 100 40Z"
                stroke="#49B89B"
                stroke-width="1.5"
                fill="none"></path>
            </svg>
          </div>
          <div
            class="absolute bottom-0 right-0 w-48 h-48 opacity-[0.12] pointer-events-none transform translate-x-1/4 translate-y-1/4"
          >
            <svg
              viewBox="0 0 200 200"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <circle
                cx="100"
                cy="100"
                r="80"
                stroke="#49B89B"
                stroke-width="1"
                stroke-dasharray="4 6"></circle>
              <circle
                cx="100"
                cy="100"
                r="60"
                stroke="#49B89B"
                stroke-width="1"
                stroke-dasharray="2 4"></circle>
              <circle cx="100" cy="100" r="40" stroke="#49B89B" stroke-width="1"
              ></circle>
            </svg>
          </div>
          <div
            class="absolute top-1/3 left-4 opacity-[0.10] pointer-events-none"
          >
            <svg width="50" height="50" viewBox="0 0 50 50" fill="none">
              <circle
                cx="25"
                cy="25"
                r="20"
                stroke="#49B89B"
                stroke-width="1.5"
                fill="none"></circle>
              <circle
                cx="25"
                cy="25"
                r="12"
                stroke="#49B89B"
                stroke-width="1"
                fill="none"></circle>
            </svg>
          </div>

          {/* Icon */}
          {
            visionIcono?.asset?.url ? (
              <div class="mb-6 sm:mb-8 inline-flex h-14 w-14 sm:h-16 sm:w-16 items-center justify-center rounded-2xl bg-secondary/5 border border-secondary/10 transition-all duration-500 group-hover:bg-secondary/10 group-hover:scale-110 group-hover:shadow-glow-secondary">
                <img
                  src={getImageUrl(visionIcono.asset.url)}
                  alt={visionIcono.alt || visionTitulo}
                  class="h-8 w-8 sm:h-10 sm:w-10 object-contain"
                />
              </div>
            ) : (
              <div class="mb-6 sm:mb-8 inline-flex h-14 w-14 sm:h-16 sm:w-16 items-center justify-center rounded-2xl bg-secondary/10 text-secondary transition-all duration-500 group-hover:bg-secondary group-hover:text-white group-hover:shadow-glow-secondary">
                <svg
                  class="h-7 w-7 sm:h-8 sm:w-8"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
                  />
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                  />
                </svg>
              </div>
            )
          }

          <h3
            class="text-2xl sm:text-3xl lg:text-4xl font-bold text-text font-display tracking-tight"
          >
            {visionTitulo}
          </h3>
          <div
            class="mt-4 sm:mt-6 space-y-4 text-sm sm:text-base leading-relaxed text-text/60 font-body font-light text-justify"
          >
            {
              visionDesc
                .split("\n\n")
                .map((parrafo) => <p set:html={formatBold(parrafo)} />)
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Valores */}
  <section class="py-16 sm:py-20 lg:py-28 bg-background overflow-hidden">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 sm:mb-16 lg:mb-20">
        <span
          class="inline-block text-xs sm:text-sm font-semibold uppercase tracking-[0.2em] text-primary mb-3 sm:mb-4 font-body"
          >{valBadge}</span
        >
        <h2
          class="text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-text font-display"
        >
          {valTitulo.split(valDestacado)[0]}<span class="text-gradient"
            >{valDestacado}</span
          >{valTitulo.split(valDestacado)[1] || ""}
        </h2>
        <p
          class="mt-4 sm:mt-6 text-base sm:text-lg text-text/70 max-w-2xl mx-auto font-body font-light px-4 sm:px-0"
        >
          {valDesc}
        </p>
      </div>
      <div
        class="grid grid-cols-1 gap-6 sm:gap-8 sm:grid-cols-2 lg:grid-cols-4"
      >
        {
          valItems.map((valor) => (
            <div class="group rounded-3xl bg-surface/5 p-8 sm:p-10 text-center border border-text/5 transition-all duration-500 hover:-translate-y-2 hover:shadow-xl hover:border-primary/10 hover:bg-white">
              <h3 class="text-xl sm:text-2xl font-semibold text-text group-hover:text-primary transition-colors duration-500 font-display">
                {valor.titulo}
              </h3>
              <p class="mt-3 sm:mt-4 text-sm leading-relaxed text-text/70 font-body font-light">
                {valor.descripcion}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* Galería */}
  <section class="py-16 sm:py-20 lg:py-28 bg-text overflow-hidden">
    <div class="absolute inset-0 noise-overlay opacity-20"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 sm:mb-16 lg:mb-20">
        <span
          class="inline-block text-xs sm:text-sm font-semibold uppercase tracking-[0.2em] text-primary mb-3 sm:mb-4 font-body"
          >{galBadge}</span
        >
        <h2
          class="text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white font-display"
        >
          {galTitulo.split(galDestacado)[0]}<span class="text-gradient"
            >{galDestacado}</span
          >{galTitulo.split(galDestacado)[1] || ""}
        </h2>
      </div>
      <GaleriaCarousel imagenes={galImagenes} client:visible />
    </div>
  </section>

  {/* Noticias */}
  {
    noticias && noticias.length > 0 && (
      <section id="noticias" class="py-16 sm:py-20 lg:py-28 bg-background overflow-hidden border-t border-text/5">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <div class="text-center mb-12 sm:mb-16">
            <span class="inline-block text-xs sm:text-sm font-semibold uppercase tracking-[0.2em] text-primary mb-3 sm:mb-4 font-body">
              Novedades
            </span>
            <h2 class="text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-text font-display">
              #NOTI <span class="text-gradient">GO</span>
            </h2>
          </div>
          <NoticiasCarousel noticias={noticias} client:visible />
        </div>
      </section>
    )
  }

  {/* CTA Section */}
  <section class="py-20 bg-surface/5 border-t border-text/5">
