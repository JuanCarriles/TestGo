  <script is:inline>
    (function () {
      var sent = false;
      function checkScroll() {
        if (sent) return;
        if (
          window.innerHeight + window.scrollY >=
          document.body.scrollHeight - 100
        ) {
          sent = true;
          if (typeof gtag !== "undefined") {
            gtag("event", "scroll_final", {
              event_category: "engagement",
              event_label: "nosotros",
            });
          }
        }
      }
      window.addEventListener("scroll", checkScroll, { passive: true });
      checkScroll();
    })();
  </script>

  <script is:inline>
    (function () {
      function playVideo() {
        var video = document.getElementById("historia-video");
        if (!video) return;
        // Forzar recarga del video después de transiciones de Astro
        video.load();
        // Pequeño delay para asegurar que el DOM esté estable
        setTimeout(function () {
          var playPromise = video.play();
          if (playPromise !== undefined) {
            playPromise.catch(function () {
              // Autoplay bloqueado por el navegador, intentar de nuevo al interactuar
            });
          }
        }, 100);
      }
      document.addEventListener("astro:page-load", playVideo);
      if (document.readyState !== "loading") playVideo();
    })();
  </script>
