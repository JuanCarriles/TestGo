---
import Layout from "../../layouts/Layout.astro";
import { client } from "../../lib/sanity";
import { queries } from "../../lib/queries";
import type { Noticia, Configuracion } from "../../types";
import PortableTextRenderer from "../../components/react/PortableTextRenderer";

// Como estamos usando modo SSR (o hybrid), obtenemos el parámetro slug de la URL
const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/nosotros');
}

// Hacemos el fetch de la noticia y de la configuración (para Navbar/Footer)
const [noticia, config] = await Promise.all([
  client.fetch<Noticia | null>(queries.noticiaBySlug, { slug }).catch(() => null),
  client.fetch<Configuracion | null>(queries.configuracion).catch(() => null),
]);

// Si no se encuentra la noticia en la base de datos, redirigimos a /404 o /nosotros
if (!noticia) {
  return Astro.redirect('/404');
}

const dateStr = new Date(noticia.fecha).toLocaleDateString('es-AR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric'
});
---

<Layout
  title={noticia.titulo}
  description={noticia.resumen}
  image={noticia.imagenPrincipal?.asset?.url}
  imageAlt={noticia.imagenPrincipal?.alt || noticia.titulo}
  config={config}
  ogType="article"
>
  <main class="bg-background pt-24 pb-16 md:pt-32 md:pb-24">
    <article class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      {/* Botón de volver */}
      <a href="/nosotros" class="inline-flex items-center text-sm font-semibold text-text/60 hover:text-primary transition-colors mb-8 font-body">
        <svg class="mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Volver a Nosotros
      </a>

      {/* Cabecera del artículo */}
      <header class="mb-10 md:mb-12">
        <time class="block text-sm font-semibold text-primary/80 uppercase tracking-widest font-body mb-4">
          {dateStr}
        </time>
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold text-text font-display leading-tight mb-6">
          {noticia.titulo}
        </h1>
        <p class="text-lg md:text-xl text-text/60 font-body font-light leading-relaxed">
          {noticia.resumen}
        </p>
      </header>

      {/* Imagen Principal */}
      {noticia.imagenPrincipal?.asset?.url && (
        <div class="mb-12 md:mb-16 rounded-3xl overflow-hidden shadow-2xl border border-text/5 bg-surface/5 aspect-video w-full">
          <img
            src={noticia.imagenPrincipal.asset.url}
            alt={noticia.imagenPrincipal.alt || noticia.titulo}
            class="h-full w-full object-cover"
          />
        </div>
      )}

      {/* Contenido */}
      <div class="prose-container">
        <PortableTextRenderer content={noticia.contenido} />
      </div>

      {/* Footer del artículo: Compartir */}
      <footer class="mt-16 pt-8 border-t border-text/10 flex flex-col sm:flex-row items-center justify-between gap-4">
        <span class="text-text/60 font-body font-semibold">Compartir esta noticia</span>
        <div class="flex items-center gap-3">
          <a
            href={`https://wa.me/?text=${encodeURIComponent(noticia.titulo + ' ' + Astro.url.href)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="h-10 w-10 flex items-center justify-center rounded-full bg-[#25D366]/10 text-[#25D366] hover:bg-[#25D366] hover:text-white transition-colors"
            aria-label="Compartir en WhatsApp"
          >
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z" />
            </svg>
          </a>
          <a
            href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(noticia.titulo)}&url=${encodeURIComponent(Astro.url.href)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="h-10 w-10 flex items-center justify-center rounded-full bg-black/5 text-black hover:bg-black hover:text-white transition-colors"
            aria-label="Compartir en X"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>
        </div>
      </footer>
    </article>
  </main>
</Layout>

<style is:global>
  /* Aquí puedes agregar estilos extra para el contenido de PortableText si lo necesitas */
  .prose-container img {
    margin-top: 2rem;
    margin-bottom: 2rem;
  }
</style>
